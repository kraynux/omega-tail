/* Regles communes aux 4 profils de rendu. Portees verbatim depuis
   omega-scan/omega-stress (D-007, D-008 : meme catalogue de themes,
   memes conventions visuelles pour toute la suite omega-).

   Boutons : patron porte tel quel. Le contour rond vit EXCLUSIVEMENT sur
   ".omega-btn-frame" (un Container), jamais sur le Button lui-meme
   ("border: none" partout) : remplir le fond d'un widget au survol/focus
   peint TOUJOURS tout son rectangle, y compris l'anneau de bordure round
   — separer decoration (frame, jamais recolore) et interactivite (Button,
   fond $accent au survol/focus) evite ce bug tout en gardant un focus
   colore selon le theme. ".omega-actions"/".omega-confirm-buttons" ne
   portent PAS de contour a eux : le bouton est deja entoure par son
   propre frame, un deuxieme cadre autour du groupe est redondant. */

Screen {
    background: $background;
    color: $foreground;
}

.omega-title {
    text-style: bold;
    color: $primary;
    border: round $accent;
    padding: 0 1;
    width: auto;
    margin: 1 0;
}

.omega-subtitle {
    color: $secondary;
    padding: 0 0 1 0;
}

.omega-hint {
    color: $foreground 60%;
    padding: 0 0 1 0;
}

.omega-hidden {
    display: none;
}

.omega-panel {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

.omega-form-panel {
    padding: 1 2;
    height: 1fr;
    align-horizontal: center;
    overflow-y: auto;
}

.omega-form-panel > Select,
.omega-form-panel > Input {
    width: 70;
    margin-bottom: 1;
}

.omega-form-panel .omega-title,
.omega-form-panel .omega-subtitle,
.omega-form-panel .omega-hint {
    width: 70;
}

.omega-form-panel .omega-title {
    content-align: center middle;
}

.omega-form-panel > .omega-actions {
    width: 70;
    align: center middle;
    height: auto;
}

.omega-home-root {
    /* Logo en haut, a une ou deux lignes du bord (demande de l'auteur, 2026-11-22 : 6 entrees par colonne) */
    align: center top;
    height: 1fr;
    overflow-y: auto;
}

.omega-splash-middle {
    width: 1fr;
}

.omega-splash-hero {
    color: $accent;
    text-align: left;
    width: auto;
}

.omega-splash-prompt {
    color: $secondary;
    width: auto;
    margin-top: 1;
    text-style: italic;
}

.omega-home-wordmark {
    width: auto;
    text-align: left;
    padding-top: 1;  /* de l'air entre le haut de l'ecran et le logo (retour de l'auteur, 2026-11-24) */
    padding-bottom: 2;  /* une ligne de plus avant les colonnes (retour de l'auteur, 2026-11-22 : trop serre) */
}

.omega-home-menu {
    background: $panel;
    border: round $accent;
    border-title-align: center;
    border-title-color: $background;
    border-title-background: $accent;
    border-title-style: bold;
    padding: 1 4;
    width: auto;
    height: auto;
}

.omega-actions {
    align: left middle;
    height: auto;
    width: auto;
    margin-top: 1;
    overflow-x: auto;
}

.omega-btn-frame {
    border: round $accent;
    padding: 0;
    width: auto;
    height: auto;
}

.omega-home-menu .omega-btn-frame {
    width: 32;
    height: 3;
    margin-bottom: 0;
    /* 0 plutot que 1 (retour utilisateur 2026-10-04 : "reduire l'espace
       entre les elements du menu dans chaque container") — meme valeur
       deja adoptee par omega-serv pour ce meme selecteur, pas une
       improvisation : les cadres de bouton se touchent directement
       (chacun garde son propre contour rond), aucun ecran vide entre
       deux boutons consecutifs. */
}

.omega-actions Button,
.omega-confirm-buttons Button,
.omega-home-menu Button {
    background: $surface;
    border: none;
    color: $foreground;
    min-width: 10;
}

.omega-home-menu Button {
    width: 100%;
    height: 100%;
    min-width: 0;
}

.omega-actions Button.-primary,
.omega-confirm-buttons Button.-primary {
    background: $surface;
    border: none;
    color: $primary;
}

.omega-actions Button.-error,
.omega-confirm-buttons Button.-error {
    background: $surface;
    border: none;
    color: $error;
}

.omega-actions Button:hover,
.omega-confirm-buttons Button:hover,
.omega-home-menu Button:hover,
.omega-actions Button:focus,
.omega-confirm-buttons Button:focus,
.omega-home-menu Button:focus {
    background: $accent;
    color: $background;
    text-style: bold;
}

.omega-actions Button.-error:hover,
.omega-confirm-buttons Button.-error:hover,
.omega-actions Button.-error:focus,
.omega-confirm-buttons Button.-error:focus {
    background: $error;
    color: $background;
    text-style: bold;
}

.omega-confirm-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 1 2;
    align: center middle;
}

.omega-confirm-title {
    text-style: bold;
    color: $error;
    width: 60;
    content-align: center middle;
    margin-bottom: 1;
}

.omega-confirm-buttons {
    width: 60;
    height: auto;
    align: center middle;
}

.omega-progress-panel {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

.omega-progress-panel > Static {
    width: auto;
}

.omega-progress-panel LoadingIndicator {
    width: auto;
    height: 3;
}

.omega-progress-log {
    width: 80%;
    max-width: 120;
    height: 12;
    margin-top: 1;
    border: round $accent;
    background: $surface;
    color: $foreground 80%;
}

.omega-modal {
    width: 80%;
    max-width: 100;
    border: round $primary;
    padding: 1 2;
    background: $surface;
}

.omega-role-badge {
    text-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

.omega-state-open { background: $success; color: $background; }
.omega-state-closed { background: $panel; color: $foreground; }
.omega-state-filtered { background: $warning; color: $background; }

DataTable {
    height: 1fr;
}

/* Tables des listes (Bibliotheque, favoris, top IP, sources SSH, archives) : hauteur du contenu, plafonnee
   (2026-11-06, retour utilisateur Statistiques : « la liste des logs disparait, seul le titre reste »).
   `1fr` dans un panneau qui defile = ecrasee a l'en-tete des que le resultat remplit l'ecran - meme piege
   et meme correctif qu'omega-fire (2026-10-28). Au-dela du plafond, la table defile elle-meme. */
#library-table, #log-list, #favorites-table, #top-ips-table, #sources-table, #backups-table,
#health-table, #automations-table {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

#profile-table {
    height: 10;
}

ToggleButton > .toggle--button {
    color: $foreground;
    text-style: dim;
}

ToggleButton.-on > .toggle--button {
    color: $success;
    text-style: bold;
}

/* Ajout propre a omega-log (menu principal a 2 colonnes, voir
   plan_omega_log.md §7) — absent des outils de reference a menu
   unicolonne, ajoute ici plutot que de surcharger .omega-home-menu. */
.omega-home-columns {
    height: auto;
    width: auto;
}

.omega-home-columns > .omega-home-menu {
    margin-right: 2;
}

/* Input par defaut en largeur 100% (CSS Textual) : a l'interieur d'un
   .omega-actions (Horizontal), ca pousse les boutons suivants hors de
   la zone visible/cliquable — bug reel rencontre sur screens/
   registry.py. Largeur fixe explicite plutot que de laisser le defaut
   deborder, meme raisonnement que .omega-form-panel > Input (base.tcss
   porte, deja largeur fixe 70 pour la meme raison dans un autre
   contexte). */
.omega-actions > Input {
    width: 40;
    margin-right: 1;
}

/* Voir et Traiter IP, recherche manuelle (portee d'omega-serv, 2026-11-07) : une IPv6 complete fait 39 caracteres. */
#ip-input {
    width: 44;
}

/* Viewer 1 (live_tail_screen.py) — panneau stats a gauche (largeur
   fixe), tableau a droite (flexible). Repris d'omega-fire. */
.omega-dash-box {
    border: round $accent;
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
    scrollbar-size-vertical: 1;  /* cadres etroits : une seule colonne pour la barre (comme omega-serv) */
}

/* Cadre de stats qui defile (omega-serv 2026-11-05, repris 2026-11-06) : #stats-box y prend sa hauteur
   naturelle, le cadre garde la largeur fixe (sans elle, le tableau voisin est ecrase a 1 colonne). */
#stats-frame {
    width: 34;
    height: 1fr;
}

/* Viewer Simple remonte (porte d'omega-serv, 2026-11-07 : l'ascenseur cachait la fin du cadre de stats) : ni
   retrait haut et bas du panneau ni marge au-dessus du titre - 3 lignes de plus pour les cadres. */
#simple-viewer-panel {
    padding: 0 2 0 2;  /* les 4 cotes : un `padding-top` seul remettait tout a zero */
}

#simple-viewer-panel .omega-title {
    margin: 0 0 1 0;
}

/* Viewer Simple (identique a omega-serv, 2026-11-02) : le corps prend toute la hauteur et le tableau
   defile - sans elle, hauteur auto : 30 lignes visibles, aucun ascenseur. */
#simple-viewer-body {
    height: 1fr;
}

#simple-viewer-body > DataTable {
    width: 1fr;
    height: 1fr;
}

/* Barre d'actions HORS de la zone qui defile (toujours visible), comme omega-serv (2026-11-06) :
   Contact et support, Se declarer. */
.omega-fixed-actions {
    padding: 0 2;
    margin-top: 0;
}

/* Sante des logs (portee d'omega-serv 2.6.0, 2026-11-07) : une ligne vide entre les sections DISQUES,
   SAUVEGARDES et SAUVEGARDES PLANIFIEES, comme dans omega-serv. */
LogHealthScreen #health-disks, LogHealthScreen #health-archives, LogHealthScreen #health-automations {
    margin-bottom: 1;
}

/* Sauvegardes planifiees : le choix de frequence n'a pas besoin de toute la largeur. */
#frequency-select {
    width: 32;
}

/* Options (2026-11-07, retour utilisateur « le menu Options a perdu son centre ») : le bloc de choix de langue
   (LanguageSetting, ajoute en 1.5.0) prenait toute la largeur, le formulaire n'etait plus centre. Meme largeur
   de 70 que les autres champs du formulaire. */
.omega-form-panel > LanguageSetting {
    width: 70;
}

.omega-form-panel > LanguageSetting > Select {
    width: 70;
    margin-bottom: 1;
}

/* omega-tail (lot C, 2026-11-10 ; plafonds en vh le 2026-11-10, retour de l'auteur : le tableau doit occuper
   l'ecran, pas 16 lignes fixes) : tables a la hauteur de leur contenu, plafonnees -
   `1fr` dans un panneau qui defile les ecraserait a l'en-tete (piege d'omega-fire et d'omega-log). */
#links-table, #registry-table, #sync-table {
    height: auto;
    max-height: 75vh;
}

#tools-table, #created-table, #linked-table, #unlinked-table, #suggestions, #known-machines {
    height: auto;
    max-height: 45vh;
}

#summary, #link-detail, #link-state, #zone-state, #registry-state {
    margin-bottom: 1;
}

#link-detail, #links-title, #linked-title, #unlinked-title {
    margin-top: 1;
}

/* omega-tail : indicateur d'attente (animation + phrase), pendant un travail long. */
.omega-busy {
    height: 3;
    margin: 1 0;
}

.omega-busy LoadingIndicator {
    width: 10;
    height: 3;
    color: $accent;
}

.omega-busy-text {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $accent;
}

/* omega-tail (lot R2) : « Faire confiance à cette machine ? » - l'empreinte SHA256 tient sur une ligne. */
.omega-trust-box {
    width: 96;
    max-width: 100%;
}

/* omega-tail (2026-11-10, retour de l'auteur : « la fenetre interieure n'englobe pas l'ecran, ascenseur alors
   qu'il reste de la place ») : Liaisons et Registre - panneau qui ne defile pas, le tableau prend toute la place
   restante (1fr est sur ici : le parent ne defile pas) et defile seul ; detail et remarques bornes. */
.omega-fill {
    overflow-y: hidden;
}

.omega-fill #links-table, .omega-fill #registry-table {
    height: 1fr;
    max-height: 100%;
    min-height: 5;
}

.omega-fill #link-detail, .omega-fill #row-detail {
    height: auto;
    max-height: 8;
    overflow-y: auto;
}

.omega-fill #notes {
    height: auto;
    max-height: 3;
}


/* Aide d'omega-tail (retour utilisateur 2026-11-11) : deux lignes d'actions hors defilement, liste des themes
   d'export a largeur fixe (en largeur libre, elle poussait Retour hors de l'ecran). */
#help-actions {
    height: auto;
}

#help-actions .omega-actions {
    margin-top: 0;
}

#export-theme {
    width: 30;
}

/* Dashboard (refonte, demande de l'auteur 2026-11-11) : cadres separes facon tableau de bord web, rangees de
   4, 2 ou 1 colonne(s) selon la largeur (screens/overview.py) ; hauteur naturelle, le panneau defile. */
.overview-grid {
    height: auto;
    grid-size: 4;
    grid-rows: auto;
    grid-gutter: 0 1;
    margin-bottom: 1;
}

.overview-card {
    height: auto;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

/* ===== omega-tail 0.1.0 ===== */
/* Bande d'etat sous l'en-tete, sur chaque ecran (proposition §2) : service, Tailscale, Funnel, CPU, temperature. */
/* Bande d'etat : dans son propre cadre, bien separee du titre (retour de l'auteur, 2026-11-23). */
.omega-status-band {
    height: auto;
    border: round $primary;
    border-title-color: $primary;
    padding: 0 1;
    margin: 0;
    background: $surface;
}

/* Tableau de bord : deux cadres cote a cote (Tailscale | Machine), puis Publication, puis Alertes. Hauteurs
   « auto » dans le panneau qui defile, jamais 1fr (piege du tableau reduit a l'en-tete). */
.tail-row {
    height: auto;
}

.tail-box {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

#alerts-table {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

#journal-log {
    height: 1fr;
    min-height: 8;
    border: round $accent;
}

.tail-journal-panel {
    padding: 1 2 0 2;
    height: 1fr;
}

.tail-journal-panel .omega-actions {
    height: auto;
}

#journal-filter {
    width: 1fr;
}

#journal-lines {
    width: 18;
}

/* Survie : bouton du bouclier colle a sa description, separation nette avant le disjoncteur (2026-11-24) */
.tail-hint-tight {
    padding: 0;
}

.tail-separator {
    margin: 1 0;
    color: $accent 50%;
}

/* Titre de section sans barre au-dessus : une ligne d'air sous les boutons qui precedent (2026-11-25) */
.tail-gap {
    margin-top: 1;
}

/* Survie : libelles et champs numeriques des seuils sur une ligne */
.tail-label {
    width: auto;
    padding: 1 1 0 0;
}

.tail-number,
.omega-actions > Input.tail-number {
    /* « .omega-actions > Input » (largeur 40) l'emportait : la ligne PURGER debordait a 140 colonnes
       (captures 2026-11-25) ; 12 : « N ou A » lisible en entier */
    width: 12;
    margin-right: 2;
}

#confinement-preview {
    width: auto;
    min-width: 60;
}

/* Pare-feu : libelles des seuils alignes, liste d'attaques sur toute la hauteur */
.tail-wide-label {
    width: 36;
}

/* Attaques et decisions : titre remonte, marges reduites, place pour la seconde ligne de boutons (2026-11-24) */
.tail-attacks-panel {
    padding: 0 2;
}

.tail-attacks-panel .omega-title {
    margin: 0 0 1 0;
}

/* Gestion de la liste noire : champs de saisie, choix de purge, tableau borne (jamais 1fr dans un panneau qui
   defile : piege du tableau reduit a l'en-tete) */
.tail-black-row {
    width: 1fr;
    margin-top: 0;
}

.tail-black-input,
.omega-actions > Input.tail-black-input {
    width: 72;
}

.tail-purge-mode {
    width: 40;
}

#black-table {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}

#attacks-table {
    height: 1fr;
    min-height: 6;
}

#mode {
    width: 40;
}

/* Connexion et reglages, Publication (lot 5) : champs a largeur fixe, tableau des publications borne en vh */
.tail-pref-select {
    width: 44;
}

.tail-pref-input {
    width: 1fr;
    max-width: 60;
}

.tail-pref-hint {
    margin-bottom: 1;
}

#pub-table {
    height: auto;
    max-height: 45vh;
    margin-bottom: 1;
}

#profile, #backup {
    width: 1fr;
    max-width: 90;
}

#add-target {
    width: 1fr;
    max-width: 60;
}

/* Connexion et reglages : changements en attente (pendant la saisie) ou resultat de la derniere application,
   hors defilement, juste au-dessus des boutons ; masque quand il n'y a rien a dire. */
#changes-frame {
    border: round $accent;
    padding: 0 1;
    margin: 0 2;
    height: auto;
    max-height: 12;
    display: none;
}

/* Champs vides : un exemple attenue situe le champ (debut et fin), sinon ton sur ton dans certains themes (retour
   auteur 2026-11-23). Ne concerne que les champs vides : une valeur proposee s'affiche normalement. */
Input > .input--placeholder {
    color: $text-muted;
}

/* Fleche des listes deroulantes en couleur vive, comme omega-serv (constat de l'auteur 2026-11-15) : on voit
   qu'il y a un choix a ouvrir, dans les 10 themes. */
SelectCurrent .arrow {
    color: $primary;
}

/* lot 7 : Reseau et appareils, Rapport, exports */
#devices-table {
    height: auto;
    max-height: 45vh;
    margin-bottom: 1;
}

#device-filter, #target {
    width: 1fr;
}

#exports-table {
    height: 1fr;
    min-height: 5;
}

#export-reader {
    height: 1fr;
    min-height: 5;
}
