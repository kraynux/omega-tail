# Statut X-Omega-Status : validated (2026-11-25, choix de vocabulaire et de ton arbitrés par Claude à la demande de l'auteur).
msgid ""
msgstr ""
"Project-Id-Version: omega-tail\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr ""
"omega-tail: không có terminal tương tác; hãy dùng « omega-tail etat »."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Không rõ tên máy: Tailscale đã kết nối chưa?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr ""
"Chứng chỉ bị từ chối ({error}). Bạn có phải là người vận hành Tailscale "
"không?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Đã gia hạn chứng chỉ, nhưng cổng gác chưa nạp lại nó ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Chứng chỉ của {name} đã cập nhật."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Không hỗ trợ cấu hình công bố này: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Không đọc được cấu hình công bố ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy chưa được cài: hãy « Cài HAProxy » trước."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "HAProxy từ chối cấu hình cổng gác: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Chưa lên lịch gia hạn chứng chỉ (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Cổng gác sẵn sàng: chứng chỉ, danh sách và cấu hình đã được kiểm tra."

msgid "La porte protège déjà Funnel."
msgstr "Cổng gác đã bảo vệ Funnel rồi."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "Cổng gác không phản hồi cục bộ ({detail}): chưa chuyển gì cả."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Chuyển đổi bị từ chối ({error}): đã đặt lại cấu hình công bố ban đầu."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel đi qua cổng gác: thử từ Internet thành công ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr ""
"Thử từ Internet thất bại ({detail}): đã đặt lại cấu hình công bố ban đầu."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Cổng gác không bảo vệ Funnel: không có gì để đặt lại."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Cấu hình công bố ban đầu chưa đầy đủ ({errors}): bản sao lưu được giữ trong "
"{path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Đã đặt lại cấu hình công bố ban đầu, y như cũ."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Đã lưu quy tắc; chúng sẽ được áp dụng khi bật bảo vệ."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Đã lưu quy tắc, cấu hình chưa được tạo lại ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "HAProxy từ chối quy tắc ({error}): giữ cấu hình cũ."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Đã ghi quy tắc, không thể nạp lại ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Đã áp dụng nóng quy tắc (chế độ {mode})."

msgid "Regroupements indisponibles."
msgstr "Gom nhóm không khả dụng."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Đang học dấu vân tay (còn {days} ngày): gom nhóm ở chế độ quan sát cho đến "
"khi kết thúc; sau đó mới có thể chọn « áp dụng »."

msgid "appliqués"
msgstr "áp dụng"

msgid "en observation"
msgstr "đang quan sát"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Đã áp dụng nóng gom nhóm ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Đã bắt đầu học lại: gom nhóm trở về chế độ quan sát trong {days} ngày học."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Cơ sở dữ liệu AS / quốc gia: quá lâu (hơn 15 phút), đã hủy; bản cũ vẫn được "
"giữ."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Danh sách đen đã đầy ({max} mục): hãy dọn dẹp hoặc xuất nó trong « Quản lý "
"danh sách đen » trước khi thêm."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Địa chỉ hoặc mạng không hợp lệ: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} thuộc tailnet: cổng gác luôn chấp nhận các máy Tailscale, không "
"thể chặn nó."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr ""
"{address} đã có trong danh sách đen (hoặc trong một mạng của danh sách)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → danh sách đen (bị từ chối cho đến khi được gỡ ra)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Đã gỡ {count} mục khỏi danh sách đen; còn lại {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Nhập: {added} đã thêm, {duplicates} trùng, {tailnet} của tailnet bị loại, "
"{invalid} dòng không hợp lệ."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Nhập: {added} đã thêm, {duplicates} trùng, {tailnet} của tailnet bị loại, "
"{invalid} dòng không hợp lệ, {over} vượt quá trần {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Không có mục nào khớp: không gỡ gì cả."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Dọn dẹp: đã gỡ {count} mục khỏi danh sách đen; còn lại {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Địa chỉ không hợp lệ: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → danh sách đen (bị từ chối cho đến khi được gỡ ra), đã gỡ khỏi "
"danh sách tin cậy."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} đang ở danh sách tin cậy (không bao giờ bị giới hạn): tin cậy được"
" ưu tiên hơn chặn. Hãy gỡ nó khỏi danh sách tin cậy trước."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Không liên lạc được cổng gác ({error}): không thể chặn tạm thời khi cổng gác"
" đã dừng."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → bị chặn {minutes} phút (chặn tạm thời)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → vẫn bị từ chối: nó thuộc một mạng trong danh sách đen."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr ""
"{address} → được chấp nhận (tuân theo quy tắc), đã gỡ khỏi danh sách đen."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr "{address} → được chấp nhận (tuân theo quy tắc), đã bỏ chặn tạm thời."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr ""
"{address} → tin cậy (không bao giờ bị giới hạn), đã gỡ khỏi danh sách đen."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → tin cậy (không bao giờ bị giới hạn)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → luôn được chấp nhận: nó thuộc tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → được chấp nhận (tuân theo quy tắc)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr ""
"Đã bắt đầu học lại: còn {days} ngày trước khi dữ liệu tham chiếu được tính."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"Chưa cập nhật cơ sở dữ liệu AS / quốc gia ({error}): bản cũ vẫn được giữ."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Cơ sở dữ liệu AS / quốc gia đã cập nhật ({countries} dải quốc gia, {asns} "
"dải AS)."

msgid "habituelle"
msgstr "quen thuộc"

msgid "limité en attaque"
msgstr "bị giới hạn khi bị tấn công"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr "Funnel đang bị cầu dao ngắt: hãy khôi phục nó trước (Sinh tồn)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Tailscale từ chối ({error}): không có gì thay đổi."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Không thể thay đổi ({error}): đã đặt lại cấu hình công bố trước đó."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr ""
"Cấu hình công bố chưa đầy đủ ({error}): hãy khôi phục bản sao lưu {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Từ chối thêm: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Đã công bố: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Cổng này đi qua cổng gác: hãy « Tắt bảo vệ » (Tường lửa Funnel) trước."

msgid "Ce point n'est plus publié."
msgstr "Điểm này không còn được công bố."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Đã gỡ: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Không đọc được bản sao lưu ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"Bảo vệ đang hoạt động: hãy « Tắt bảo vệ » (Tường lửa Funnel) trước, rồi khôi"
" phục."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Bản sao lưu này đi qua cổng gác, mà cổng gác đã dừng: « Bật bảo vệ » (Tường "
"lửa Funnel) sẽ tạo lại nó đúng cách."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Đã khôi phục bản sao lưu ngày {when}."

msgid "essai public indisponible"
msgstr "không thể thử từ Internet"

msgid "adresse du tailnet inconnue"
msgstr "không rõ địa chỉ tailnet"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel vẫn được phép trên các cổng"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel đã bị omega-tail ngắt rồi."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Không có gì để ngắt: không có cổng nào mở ra Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Không thể lên lịch bật lại ở đây."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr "Bộ hẹn giờ bật lại bị từ chối (mã {code}): chưa ngắt gì cả."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Không thể ngắt ({error}): cấu hình công bố đã được đặt lại."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Đã ngắt Funnel ({ports}) trong {minutes} phút, sau đó tự động bật lại."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Đã ngắt Funnel ({ports}) cho đến khi bạn bật lại."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Không có gì để khôi phục: Funnel không bị omega-tail ngắt."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Bộ hẹn giờ của một lần ngắt cũ: không cần làm gì."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Bật lại chưa đầy đủ ({errors}): bản sao lưu được giữ trong {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Đã bật lại Funnel, y như cũ."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale chưa được cài trên máy này."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Dịch vụ tailscaled không phản hồi (đã dừng hoặc bị lỗi)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled chưa được khởi động lại sau khi cập nhật: {daemon} đang chạy, "
"{client} đã cài."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale đang chờ đăng nhập một tài khoản."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale đã ngắt kết nối (« tailscale down »)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "Khóa của máy này hết hạn sau {days} ngày."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Trang web bị sập: Funnel đi qua cổng gác (tường lửa), nhưng cổng gác đã "
"dừng."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Cổng gác đang ở CHẾ ĐỘ TẤN CÔNG: quá nhiều kết nối đến; gom nhóm (dấu vân "
"tay, AS, quốc gia) được áp dụng cho đến khi yên tĩnh trở lại."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel được công bố mà không có bảo vệ trên cổng {port}: tailscaled làm TLS "
"cho từng kết nối (một đợt dồn dập có thể làm bão hòa máy)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Nhiệt độ cao: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled tiêu thụ {cpu:.0f} % của một lõi."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"Giám sát tự động đã được bật nhưng không còn chạy: Funnel sẽ không tự bị "
"ngắt khi bị tấn công."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Danh sách đen của cổng gác: {count} mục (trần {max}). Hãy xuất nó rồi dọn "
"dẹp các mục cũ nhất: « Tấn công và quyết định » → « Quản lý danh sách đen »."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Lá chắn cổng WireGuard VẮNG MẶT: một công cụ khác đã xóa bảng của nó (nft "
"flush ruleset, tường lửa khởi động lại…). Nó không tự được đặt lại: « Sinh "
"tồn » → « Lá chắn cổng WireGuard » → « Đặt lại »."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Lá chắn cổng WireGuard: trạng thái không được cập nhật hơn 3 phút (dịch vụ "
"omega-bouclier-wg đã dừng?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Khi khởi động, tailscaled chạy « tailscale up »: nếu một thiết lập thay đổi "
"(người vận hành, tên, tuyến…), Tailscale sẽ từ chối và tailscaled sẽ không "
"khởi động lại được nữa. « Dịch vụ » → « Sửa khởi động »."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Mất giới hạn tài nguyên của tailscaled (dịch vụ đã khởi động lại): « Sinh "
"tồn » → « Áp dụng giới hạn tài nguyên »."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled không bị giới hạn tài nguyên: khi bị tấn công, nó có thể chiếm "
