msgstr "Funnel bị ngắt"

msgid "Funnel fermé"
msgstr "Funnel đóng"

msgid "Pare-feu actif · attaque"
msgstr "Tường lửa bật · tấn công"

msgid "Pare-feu actif"
msgstr "Tường lửa bật"

msgid "Pare-feu arrêté"
msgstr "Tường lửa dừng"

msgid "Pare-feu inactif"
msgstr "Tường lửa tắt"

