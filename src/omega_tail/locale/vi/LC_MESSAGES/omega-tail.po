msgid "CPU machine {cpu:.0f} %"
msgstr "CPU máy {cpu:.0f} %"

#, python-brace-format
msgid "CPU tailscaled {cpu:.0f} %"
msgstr "CPU tailscaled {cpu:.0f} %"

