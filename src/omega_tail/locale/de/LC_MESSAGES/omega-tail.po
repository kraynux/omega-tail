"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr ""
"omega-tail: kein interaktives Terminal; verwenden Sie „omega-tail etat“."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Name des Rechners unbekannt: Ist Tailscale verbunden?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Zertifikat abgelehnt ({error}). Sind Sie Operator von Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Zertifikat erneuert, aber das Tor hat es nicht übernommen ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Zertifikat von {name} ist aktuell."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Veröffentlichung nicht unterstützt: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Veröffentlichung unlesbar ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy ist nicht installiert: zuerst „HAProxy installieren“."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Konfiguration des Tors von HAProxy abgelehnt: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Erneuerung des Zertifikats nicht geplant (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Tor bereit: Zertifikat, Listen und Konfiguration geprüft."

msgid "La porte protège déjà Funnel."
msgstr "Das Tor schützt Funnel bereits."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr ""
"Das Tor antwortet lokal nicht ({detail}): Es wurde nichts umgeschaltet."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr ""
"Umschaltung abgelehnt ({error}): ursprüngliche Veröffentlichung "
"wiederhergestellt."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel läuft über das Tor: öffentlicher Test erfolgreich ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr ""
"Öffentlicher Test fehlgeschlagen ({detail}): ursprüngliche Veröffentlichung "
"wiederhergestellt."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Das Tor schützt Funnel nicht: nichts wiederherzustellen."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Ursprüngliche Veröffentlichung unvollständig ({errors}): Sicherung in {path}"
" aufbewahrt."

msgid "Publication d'origine remise, à l'identique."
msgstr "Ursprüngliche Veröffentlichung unverändert wiederhergestellt."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Regeln gespeichert; sie gelten ab der Aktivierung."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Regeln gespeichert, Konfiguration nicht neu erzeugt ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Regeln von HAProxy abgelehnt ({error}): alte Konfiguration beibehalten."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Regeln geschrieben, Neuladen unmöglich ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Regeln im laufenden Betrieb angewendet (Modus {mode})."

msgid "Regroupements indisponibles."
msgstr "Gruppierungen nicht verfügbar."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Lernphase der Fingerabdrücke läuft (noch {days} Tag(e)): Die Gruppierungen "
"bleiben bis zum Ende in Beobachtung; „angewendet“ ist danach möglich."

msgid "appliqués"
msgstr "angewendet"

msgid "en observation"
msgstr "in Beobachtung"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Gruppierungen im laufenden Betrieb angewendet ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Lernphase neu gestartet: Gruppierungen für die {days} Lerntage wieder in "
"Beobachtung."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"AS-/Länder-Datenbank: zu lange (über 15 Minuten), abgebrochen; die alte "
"bleibt bestehen."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Sperrliste voll ({max} Einträge): Bereinigen oder exportieren Sie sie in "
"„Verwaltung der Sperrliste“, bevor Sie weitere hinzufügen."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Ungültige Adresse oder ungültiges Netz: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} gehört zum Tailnet: Das Tor lässt Tailscale-Rechner immer zu, sie "
"kann nicht gesperrt werden."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} ist bereits in der Sperrliste (oder in einem ihrer Netze)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → Sperrliste (abgelehnt bis zur Entfernung)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"{count} Eintrag/Einträge aus der Sperrliste entfernt; {left} verbleiben."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Import: {added} hinzugefügt, {duplicates} Duplikat(e), {tailnet} aus dem "
"Tailnet ausgeschlossen, {invalid} ungültige Zeile(n)."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Import: {added} hinzugefügt, {duplicates} Duplikat(e), {tailnet} aus dem "
"Tailnet ausgeschlossen, {invalid} ungültige Zeile(n), {over} über der "
"Obergrenze von {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Kein Eintrag passt: Es wurde nichts entfernt."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"Bereinigung: {count} Eintrag/Einträge aus der Sperrliste entfernt; {left} "
"verbleiben."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Ungültige Adresse: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → Sperrliste (abgelehnt bis zur Entfernung), aus dem Vertrauen "
"entfernt."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} ist im Vertrauen (nie begrenzt): Vertrauen geht vor Sperre. "
"Entfernen Sie sie zuerst aus dem Vertrauen."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Tor nicht erreichbar ({error}): vorübergehende Sperre bei gestopptem Tor "
"unmöglich."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → gesperrt für {minutes} min (vorübergehende Sperre)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr ""
"{address} → weiterhin abgelehnt: Sie gehört zu einem Netz in der Sperrliste."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr ""
"{address} → zugelassen (den Regeln unterworfen), aus der Sperrliste "
"entfernt."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → zugelassen (den Regeln unterworfen), vorübergehende Sperre "
"aufgehoben."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} → Vertrauen (nie begrenzt), aus der Sperrliste entfernt."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → Vertrauen (nie begrenzt)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → immer zugelassen: Sie gehört zum Tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → zugelassen (den Regeln unterworfen)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "Lernphase neu gestartet: {days} Tage, bevor die Referenz zählt."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"AS-/Länder-Datenbank nicht aktualisiert ({error}): Die alte bleibt bestehen."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"AS-/Länder-Datenbank aktuell ({countries} Länderbereiche, {asns} AS-"
"Bereiche)."

msgid "habituelle"
msgstr "üblich"

msgid "limité en attaque"
msgstr "im Angriff begrenzt"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel ist durch den Schutzschalter abgeschaltet: Stellen Sie ihn zuerst "
"wieder her (Überleben)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Von Tailscale abgelehnt ({error}): Nichts wurde geändert."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr ""
"Änderung unmöglich ({error}): vorherige Veröffentlichung wiederhergestellt."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr ""
"Veröffentlichung unvollständig ({error}): Stellen Sie die Sicherung {path} "
"wieder her."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Hinzufügen abgelehnt: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Veröffentlicht: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Dieser Port läuft über das Tor: zuerst „Schutz deaktivieren“ (Funnel-"
"Firewall)."

msgid "Ce point n'est plus publié."
msgstr "Dieser Punkt ist nicht mehr veröffentlicht."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Entfernt: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Sicherung unlesbar ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"Der Schutz ist aktiv: zuerst „Schutz deaktivieren“ (Funnel-Firewall), dann "
"wiederherstellen."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Diese Sicherung läuft über das Tor, das gestoppt ist: „Schutz aktivieren“ "
"(Funnel-Firewall) erstellt es sauber neu."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Sicherung vom {when} wiederhergestellt."

msgid "essai public indisponible"
msgstr "öffentlicher Test nicht verfügbar"

msgid "adresse du tailnet inconnue"
msgstr "Tailnet-Adresse unbekannt"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel noch erlaubt auf den Ports"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel ist bereits von omega-tail abgeschaltet."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Nichts abzuschalten: Kein Port ist zum Internet geöffnet."

msgid "Remise en route programmée impossible ici."
msgstr "Geplante Wiederinbetriebnahme hier unmöglich."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Timer für die Wiederinbetriebnahme abgelehnt (Code {code}): Es wurde nichts "
"abgeschaltet."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr ""
"Abschaltung unmöglich ({error}): Die Veröffentlichung wurde "
"wiederhergestellt."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel abgeschaltet ({ports}) für {minutes} min, danach automatisch wieder "
"in Betrieb."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel abgeschaltet ({ports}) bis zu Ihrer Wiederinbetriebnahme."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr ""
"Nichts wiederherzustellen: Funnel ist nicht von omega-tail abgeschaltet."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Timer einer alten Abschaltung: nichts zu tun."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Wiederinbetriebnahme unvollständig ({errors}): Sicherung in {path} "
"aufbewahrt."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel unverändert wieder in Betrieb."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale ist auf diesem Rechner nicht installiert."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Der Dienst tailscaled antwortet nicht (gestoppt oder fehlgeschlagen)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled wurde nach dem Update nicht neu gestartet: {daemon} läuft, "
"{client} installiert."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale wartet auf die Anmeldung eines Kontos."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale ist getrennt („tailscale down“)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "Der Schlüssel dieses Rechners läuft in {days} Tag(en) ab."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Website ausgefallen: Funnel läuft über das Tor (Firewall), aber das Tor ist "
"gestoppt."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Das Tor ist im ANGRIFFSMODUS: zu viele eingehende Verbindungen; die "
"Gruppierungen (Fingerabdrücke, AS, Länder) gelten bis zur Rückkehr der Ruhe."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel ohne Schutz auf Port {port} veröffentlicht: tailscaled übernimmt das "
"TLS jeder Verbindung (ein Ansturm kann den Rechner auslasten)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Hohe Temperatur: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled verbraucht {cpu:.0f} % eines Kerns."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"Die automatische Überwachung ist aktiviert, läuft aber nicht mehr: Funnel "
"wird unter Angriff nicht selbsttätig abgeschaltet."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Sperrliste des Tors: {count} Einträge (Obergrenze {max}). Exportieren Sie "
"sie und bereinigen Sie dann die ältesten: „Angriffe und Entscheidungen“ → "
"„Verwaltung der Sperrliste“."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Schutzschild des WireGuard-Ports FEHLT: Ein anderes Werkzeug hat seine "
"Tabelle gelöscht (nft flush ruleset, Firewall neu gestartet…). Es wird nicht"
" selbsttätig neu gesetzt: „Überleben“ → „Schutzschild des WireGuard-Ports“ →"
" „Neu setzen“."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Schutzschild des WireGuard-Ports: Status seit über 3 Minuten nicht "
"aktualisiert (Dienst omega-bouclier-wg gestoppt?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Der Start von tailscaled führt „tailscale up“ aus: Ändert sich eine "
"Einstellung (Operator, Name, Routen…), lehnt Tailscale es ab und tailscaled "
"startet nicht mehr. „Dienst“ → „Start korrigieren“."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Eindämmung von tailscaled verloren (der Dienst wurde neu gestartet): "
"„Überleben“ → „Eindämmung anwenden“."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled ist nicht eingedämmt: Unter Angriff kann es alle Kerne belegen."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr ""
"Sie sind nicht Operator von Tailscale: Jede Einstellung erfordert sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel von omega-tail abgeschaltet (vollständige Abschaltung): manuelle "
"Wiederinbetriebnahme unter „Überleben“."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel sollte um {time} wieder in Betrieb gehen und ist es nicht: "
"„Wiederherstellen“ unter „Überleben“."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel von omega-tail bis {time} abgeschaltet, danach automatisch wieder in "
"Betrieb."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale meldet: {message}"

msgid "ajout manuel"
msgstr "manuell hinzugefügt"

msgid "import"
msgstr "Import"

msgid "écran Attaques"
msgstr "Bildschirm Angriffe"

msgid "avant les dates"
msgstr "vor den Daten"

