msgid ""
msgstr ""
"Project-Id-Version: omega-tail\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: nenhum terminal interativo; use « omega-tail etat »."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Nome da máquina desconhecido: o Tailscale está conectado?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Certificado recusado ({error}). Você é operador do Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Certificado renovado, mas o portão não o recarregou ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Certificado de {name} em dia."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Publicação não suportada: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Publicação ilegível ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "O HAProxy não está instalado: primeiro « Instalar o HAProxy »."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Configuração do portão recusada pelo HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Renovação do certificado não agendada (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Portão pronto: certificado, listas e configuração verificados."

msgid "La porte protège déjà Funnel."
msgstr "O portão já protege o Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "O portão não responde localmente ({detail}): nada foi trocado."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Troca recusada ({error}): publicação original restaurada."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "O Funnel passa pelo portão: teste público bem-sucedido ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "Teste público falhou ({detail}): publicação original restaurada."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "O portão não protege o Funnel: nada a restaurar."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Publicação original incompleta ({errors}): backup guardado em {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Publicação original restaurada, idêntica."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Regras salvas; elas serão aplicadas na ativação."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Regras salvas, configuração não regenerada ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Regras recusadas pelo HAProxy ({error}): configuração anterior mantida."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Regras gravadas, recarga impossível ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Regras aplicadas a quente (modo {mode})."

msgid "Regroupements indisponibles."
msgstr "Agrupamentos indisponíveis."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Aprendizado das impressões digitais em curso (ainda {days} dia(s)): os "
"agrupamentos ficam em observação até o fim; « aplicados » será possível "
"depois."

msgid "appliqués"
msgstr "aplicados"

msgid "en observation"
msgstr "em observação"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Agrupamentos aplicados a quente ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Aprendizado reiniciado: agrupamentos de volta à observação durante os {days}"
" dias de aprendizado."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Base AS / países: demorou demais (mais de 15 minutos), abandonada; a "
"anterior continua em uso."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Lista negra cheia ({max} entradas): limpe-a ou exporte-a em « Gerenciamento "
"da lista negra » antes de incluir mais."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Endereço ou rede inválido: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} faz parte do tailnet: o portão sempre admite as máquinas "
"Tailscale, ele não pode ser bloqueado."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} já está na lista negra (ou em uma de suas redes)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → lista negra (recusado até a remoção)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Entradas removidas da lista negra: {count}; restam {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Importação: {added} incluída(s), {duplicates} duplicata(s), {tailnet} do "
"tailnet descartada(s), {invalid} linha(s) inválida(s)."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Importação: {added} incluída(s), {duplicates} duplicata(s), {tailnet} do "
"tailnet descartada(s), {invalid} linha(s) inválida(s), {over} além do teto "
"de {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Nenhuma entrada corresponde: nada foi removido."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Limpeza: entradas removidas da lista negra: {count}; restam {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Endereço inválido: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → lista negra (recusado até a remoção), removido da confiança."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} está em confiança (nunca limitado): a confiança tem prioridade "
"sobre o bloqueio. Remova-o da confiança primeiro."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Portão inacessível ({error}): bloqueio temporário impossível, portão parado."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → bloqueado {minutes} min (bloqueio temporário)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → sempre recusado: faz parte de uma rede na lista negra."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} → admitido (sujeito às regras), removido da lista negra."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → admitido (sujeito às regras), bloqueio temporário suspenso."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} → confiança (nunca limitado), removido da lista negra."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → confiança (nunca limitado)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → sempre admitido: faz parte do tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → admitido (sujeito às regras)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "Aprendizado reiniciado: {days} dias antes que a referência conte."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"Base AS / países não atualizada ({error}): a anterior continua em uso."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Base AS / países atualizada ({countries} faixas de países, {asns} faixas de "
"AS)."

msgid "habituelle"
msgstr "habitual"

msgid "limité en attaque"
msgstr "limitado em ataque"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"O Funnel está cortado pelo disjuntor: restabeleça-o primeiro "
"(Sobrevivência)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Recusado pelo Tailscale ({error}): nada mudou."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Mudança impossível ({error}): publicação anterior restaurada."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Publicação incompleta ({error}): restaure o backup {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Inclusão recusada: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Publicado: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Esta porta passa pelo portão: primeiro « Desativar a proteção » (Firewall do"
" Funnel)."

msgid "Ce point n'est plus publié."
msgstr "Este ponto não está mais publicado."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Removido: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Backup ilegível ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"A proteção está ativa: primeiro « Desativar a proteção » (Firewall do "
"Funnel), depois restaure."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Este backup passa pelo portão, que está parado: « Ativar a proteção » "
"(Firewall do Funnel) o recria corretamente."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Backup de {when} restaurado."

msgid "essai public indisponible"
msgstr "teste público indisponível"

msgid "adresse du tailnet inconnue"
msgstr "endereço do tailnet desconhecido"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel ainda autorizado nas portas"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "O Funnel já está cortado pelo omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Nada a cortar: nenhuma porta está aberta para a Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Religamento agendado impossível aqui."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Temporizador de religamento recusado (código {code}): nada foi cortado."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Corte impossível ({error}): a publicação foi restaurada."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel cortado ({ports}) por {minutes} min, depois religado automaticamente."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel cortado ({ports}) até você religá-lo."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Nada a restabelecer: o Funnel não está cortado pelo omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Temporizador de um corte antigo: nada a fazer."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Religamento incompleto ({errors}): backup guardado em {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel religado, idêntico."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "O Tailscale não está instalado nesta máquina."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "O serviço tailscaled não responde (parado ou com falha)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"O tailscaled não foi reiniciado após a atualização: {daemon} em execução, "
"{client} instalado."

msgid "Tailscale attend la connexion d'un compte."
msgstr "O Tailscale aguarda a conexão de uma conta."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "O Tailscale está desconectado (« tailscale down »)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "A chave desta máquina expira em {days} dia(s)."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Site fora do ar: o Funnel passa pelo portão (firewall), mas o portão está "
"parado."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"O portão está em MODO ATAQUE: conexões de entrada demais; os agrupamentos "
"(impressões digitais, AS, países) se aplicam até a volta da calma."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel publicado sem proteção na porta {port}: o tailscaled faz o TLS de "
"cada conexão (uma rajada pode saturar a máquina)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Temperatura elevada: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "O tailscaled consome {cpu:.0f} % de um núcleo."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"A vigilância automática está ativada mas não está mais rodando: o Funnel não"
" será cortado sozinho sob ataque."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Lista negra do portão: {count} entradas (teto {max}). Exporte-a e depois "
"limpe as mais antigas: « Ataques e decisões » → « Gerenciamento da lista "
"negra »."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Escudo da porta WireGuard AUSENTE: outra ferramenta apagou a sua tabela (nft"
" flush ruleset, firewall reiniciado…). Ele não é reaplicado sozinho: « "
"Sobrevivência » → « Escudo da porta WireGuard » → « Reaplicar »."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Escudo da porta WireGuard: estado não atualizado há mais de 3 minutos "
"(serviço omega-bouclier-wg parado?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"A inicialização do tailscaled executa « tailscale up »: se uma configuração "
"mudar (operador, nome, rotas…), o Tailscale a recusará e o tailscaled não "
"reiniciará mais. « Serviço » → « Corrigir a inicialização »."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Confinamento do tailscaled perdido (o serviço reiniciou): « Sobrevivência » "
"→ « Aplicar o confinamento »."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"O tailscaled não está confinado: sob ataque, ele pode tomar todos os "
"núcleos."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "Você não é operador do Tailscale: cada configuração pedirá sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel cortado pelo omega-tail (corte total): religamento manual, em « "
"Sobrevivência »."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"O Funnel devia ser religado às {time} e não foi: « Restabelecer » em « "
"Sobrevivência »."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel cortado pelo omega-tail até {time}, depois religado automaticamente."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "O Tailscale informa: {message}"

msgid "ajout manuel"
msgstr "inclusão manual"

msgid "import"
msgstr "importação"

msgid "écran Attaques"
msgstr "tela Ataques"

msgid "avant les dates"
msgstr "antes das datas"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Temperatura de {temperature:.0f} °C (limite {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"O tailscaled acima de {threshold:.0f} % de um núcleo há {seconds} s (média "
"{average:.0f} %)."

msgid "cible non prise en charge"
msgstr "destino não suportado"

msgid "nom de machine inattendu"
msgstr "nome de máquina inesperado"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "nenhuma porta está aberta para a Internet (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "várias portas Funnel: por enquanto o portão protege só uma"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "O Funnel já passa por um portão (TCP + PROXY v2)"

msgid "seule une publication HTTPS avec le chemin « / » est prise en charge"
msgstr "só é suportada uma publicação HTTPS com o caminho « / »"

msgid "Chrome, Edge, Firefox récent"
msgstr "Chrome, Edge, Firefox recente"

msgid "Firefox (ancien)"
msgstr "Firefox (antigo)"

msgid "empreinte"
msgstr "impressão"

msgid "hébergeur"
msgstr "hospedagem"

msgid "pays"
msgstr "país"

msgid "Identité"
msgstr "Identidade"

msgid "Réseau"
msgstr "Rede"

msgid "Sortie"
msgstr "Saída"

msgid "Services Tailscale"
msgstr "Serviços Tailscale"

msgid "Opérateur"
msgstr "Operador"

msgid "Nom de la machine"
msgstr "Nome da máquina"

msgid ""
"Nom dans le tailnet (vide : celui du système). Change aussi l'adresse "
"*.ts.net : les liens publiés et le certificat suivent."
msgstr ""
"Nome no tailnet (vazio: o do sistema). Também muda o endereço *.ts.net: os "
"links publicados e o certificado acompanham."

msgid "ex. serveur-maison"
msgstr "ex. servidor-casa"

msgid "Surnom du compte"
msgstr "Apelido da conta"

msgid ""
"Surnom du compte en cours, pour le reconnaître dans « Changer de compte »."
msgstr "Apelido da conta atual, para reconhecê-la em « Trocar de conta »."

msgid "ex. maison"
msgstr "ex. casa"

msgid "Accepter les routes"
msgstr "Aceitar as rotas"

msgid ""
"Utiliser les sous-réseaux annoncés par les autres machines. À éviter sur une"
" machine du même réseau local que le routeur qui l'annonce."
msgstr ""
"Usar as sub-redes anunciadas pelas outras máquinas. Evite em uma máquina da "
"mesma rede local que o roteador que a anuncia."

msgid "Accepter le DNS du tailnet"
msgstr "Aceitar o DNS do tailnet"

msgid "MagicDNS : les noms des machines du tailnet se résolvent ici."
msgstr "MagicDNS: os nomes das máquinas do tailnet são resolvidos aqui."

msgid "Bouclier (refuser les connexions entrantes)"
msgstr "Escudo (recusar conexões de entrada)"

msgid ""
"Aucune machine du tailnet ne peut se connecter à celle-ci (SSH et Serve "
"compris). Funnel n'est pas concerné."
msgstr ""
"Nenhuma máquina do tailnet pode se conectar a esta (SSH e Serve incluídos). "
"O Funnel não é afetado."

msgid "Filtrage avec état"
msgstr "Filtragem com estado"

msgid ""
"Pour un routeur de sous-réseau ou un nœud de sortie : ne laisse revenir que "
"les réponses."
msgstr ""
"Para um roteador de sub-rede ou um nó de saída: só deixa voltar as "
"respostas."

msgid "Mode netfilter"
msgstr "Modo netfilter"

msgid ""
"on : Tailscale gère ses règles de pare-feu ; nodivert : ses chaînes sans les"
" brancher ; off : aucune règle (à vos risques)."
msgstr ""
"on: o Tailscale gerencia suas regras de firewall; nodivert: suas cadeias sem"
" conectá-las; off: nenhuma regra (por sua conta e risco)."

msgid "Nœud de sortie utilisé"
msgstr "Nó de saída usado"

msgid ""
"Faire passer le trafic Internet de cette machine par une autre machine du "
