"Project-Id-Version: omega-tail\n"
"Language: nl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: geen interactieve terminal; gebruik „omega-tail etat”."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Naam van de machine onbekend: is Tailscale verbonden?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Certificaat geweigerd ({error}). Bent u operator van Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr ""
"Certificaat vernieuwd, maar de slagboom heeft het niet overgenomen "
"({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Certificaat van {name} is actueel."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Publicatie niet ondersteund: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Publicatie onleesbaar ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy is niet geïnstalleerd: eerst „HAProxy installeren”."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Configuratie van de slagboom geweigerd door HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Vernieuwing van het certificaat niet gepland (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Slagboom gereed: certificaat, lijsten en configuratie gecontroleerd."

msgid "La porte protège déjà Funnel."
msgstr "De slagboom beschermt Funnel al."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr ""
"De slagboom antwoordt niet lokaal ({detail}): er is niets omgeschakeld."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr ""
"Omschakeling geweigerd ({error}): oorspronkelijke publicatie teruggezet."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel loopt via de slagboom: publieke test geslaagd ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr ""
"Publieke test mislukt ({detail}): oorspronkelijke publicatie teruggezet."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "De slagboom beschermt Funnel niet: niets terug te zetten."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Oorspronkelijke publicatie onvolledig ({errors}): back-up bewaard in {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Oorspronkelijke publicatie ongewijzigd teruggezet."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Regels opgeslagen; ze gaan in bij de activering."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Regels opgeslagen, configuratie niet opnieuw gegenereerd ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "Regels geweigerd door HAProxy ({error}): oude configuratie behouden."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Regels geschreven, herladen onmogelijk ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Regels live toegepast (modus {mode})."

msgid "Regroupements indisponibles."
msgstr "Groeperingen niet beschikbaar."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Leerfase van de vingerafdrukken bezig (nog {days} dag(en)): de groeperingen "
"blijven tot het einde in observatie; „toegepast” is daarna mogelijk."

msgid "appliqués"
msgstr "toegepast"

msgid "en observation"
msgstr "in observatie"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Groeperingen live toegepast ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Leerfase opnieuw gestart: groeperingen terug in observatie voor de {days} "
"leerdagen."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"AS-/landendatabase: te lang (meer dan 15 minuten), afgebroken; de oude "
"blijft staan."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Blokkeerlijst vol ({max} items): schoon haar op of exporteer haar in „Beheer"
" van de blokkeerlijst” voordat u er meer toevoegt."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Ongeldig adres of netwerk: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} hoort bij het tailnet: de slagboom laat Tailscale-machines altijd "
"toe, het kan niet geblokkeerd worden."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr ""
"{address} staat al in de blokkeerlijst (of in een van haar netwerken)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → blokkeerlijst (geweigerd tot verwijdering)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"{count} item(s) uit de blokkeerlijst verwijderd; er blijven er {left} over."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Import: {added} toegevoegd, {duplicates} dubbel(s), {tailnet} uit het "
"tailnet uitgesloten, {invalid} ongeldige regel(s)."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Import: {added} toegevoegd, {duplicates} dubbel(s), {tailnet} uit het "
"tailnet uitgesloten, {invalid} ongeldige regel(s), {over} boven het plafond "
"van {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Geen enkel item komt overeen: er is niets verwijderd."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"Opschoning: {count} item(s) uit de blokkeerlijst verwijderd; er blijven er "
"{left} over."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Ongeldig adres: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → blokkeerlijst (geweigerd tot verwijdering), uit het vertrouwen "
"gehaald."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} staat in het vertrouwen (nooit beperkt): vertrouwen gaat voor "
"blokkering. Haal het eerst uit het vertrouwen."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Slagboom onbereikbaar ({error}): tijdelijke blokkering onmogelijk bij "
"gestopte slagboom."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → {minutes} min geblokkeerd (tijdelijke blokkering)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr ""
"{address} → nog steeds geweigerd: het hoort bij een netwerk in de "
"blokkeerlijst."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr ""
"{address} → toegelaten (onderworpen aan de regels), uit de blokkeerlijst "
"verwijderd."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → toegelaten (onderworpen aan de regels), tijdelijke blokkering "
"opgeheven."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr ""
"{address} → vertrouwen (nooit beperkt), uit de blokkeerlijst verwijderd."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → vertrouwen (nooit beperkt)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → altijd toegelaten: het hoort bij het tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → toegelaten (onderworpen aan de regels)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "Leerfase opnieuw gestart: {days} dagen voordat de referentie telt."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr "AS-/landendatabase niet bijgewerkt ({error}): de oude blijft staan."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"AS-/landendatabase actueel ({countries} landenbereiken, {asns} AS-bereiken)."

msgid "habituelle"
msgstr "gebruikelijk"

msgid "limité en attaque"
msgstr "beperkt bij aanval"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel is uitgeschakeld door de stroomonderbreker: herstel het eerst "
"(Overleven)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Geweigerd door Tailscale ({error}): er is niets veranderd."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Wijziging onmogelijk ({error}): vorige publicatie teruggezet."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Publicatie onvolledig ({error}): zet de back-up {path} terug."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Toevoegen geweigerd: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Gepubliceerd: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Deze poort loopt via de slagboom: eerst „Bescherming deactiveren” (Funnel-"
"firewall)."

msgid "Ce point n'est plus publié."
msgstr "Dit punt is niet meer gepubliceerd."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Verwijderd: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Back-up onleesbaar ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"De bescherming is actief: eerst „Bescherming deactiveren” (Funnel-firewall),"
" daarna terugzetten."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Deze back-up loopt via de slagboom, die gestopt is: „Bescherming activeren” "
"(Funnel-firewall) maakt hem netjes opnieuw aan."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Back-up van {when} teruggezet."

msgid "essai public indisponible"
msgstr "publieke test niet beschikbaar"

msgid "adresse du tailnet inconnue"
msgstr "tailnet-adres onbekend"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel nog toegestaan op de poorten"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel is al uitgeschakeld door omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Niets uit te schakelen: geen enkele poort staat open naar internet."

msgid "Remise en route programmée impossible ici."
msgstr "Geplande herinschakeling hier onmogelijk."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Timer voor herinschakeling geweigerd (code {code}): er is niets "
"uitgeschakeld."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Uitschakeling onmogelijk ({error}): de publicatie is teruggezet."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel uitgeschakeld ({ports}) voor {minutes} min, daarna automatisch weer "
"ingeschakeld."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel uitgeschakeld ({ports}) tot u het weer inschakelt."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Niets te herstellen: Funnel is niet uitgeschakeld door omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Timer van een oude uitschakeling: niets te doen."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Herinschakeling onvolledig ({errors}): back-up bewaard in {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel ongewijzigd weer ingeschakeld."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale is niet geïnstalleerd op deze machine."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "De dienst tailscaled antwoordt niet (gestopt of mislukt)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled is na de update niet herstart: {daemon} draait, {client} "
"geïnstalleerd."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale wacht op de aanmelding van een account."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale is afgemeld („tailscale down”)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "De sleutel van deze machine verloopt over {days} dag(en)."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Site plat: Funnel loopt via de slagboom (firewall), maar de slagboom is "
"gestopt."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"De slagboom staat in AANVALSMODUS: te veel inkomende verbindingen; de "
"groeperingen (vingerafdrukken, AS, landen) gelden tot de rust terugkeert."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel gepubliceerd zonder bescherming op poort {port}: tailscaled doet de "
"TLS van elke verbinding (een vloedgolf kan de machine verzadigen)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Hoge temperatuur: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled verbruikt {cpu:.0f} % van een kern."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"De automatische bewaking is geactiveerd maar draait niet meer: Funnel wordt "
"bij een aanval niet vanzelf uitgeschakeld."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Blokkeerlijst van de slagboom: {count} items (plafond {max}). Exporteer haar"
" en schoon daarna de oudste op: „Aanvallen en beslissingen” → „Beheer van de"
" blokkeerlijst”."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Schild van de WireGuard-poort AFWEZIG: een ander hulpmiddel heeft zijn tabel"
" gewist (nft flush ruleset, firewall herstart…). Het wordt niet vanzelf "
"opnieuw geplaatst: „Overleven” → „Schild van de WireGuard-poort” → „Opnieuw "
"plaatsen”."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Schild van de WireGuard-poort: status al meer dan 3 minuten niet bijgewerkt "
"(dienst omega-bouclier-wg gestopt?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Het opstarten van tailscaled voert „tailscale up” uit: als een instelling "
"verandert (operator, naam, routes…), weigert Tailscale het en start "
"tailscaled niet meer. „Dienst” → „Opstart herstellen”."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Inperking van tailscaled verloren (de dienst is herstart): „Overleven” → "
"„Inperking toepassen”."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled is niet ingeperkt: bij een aanval kan het alle kernen innemen."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "U bent geen operator van Tailscale: elke instelling vraagt om sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel uitgeschakeld door omega-tail (volledige uitschakeling): handmatig "
"weer inschakelen in „Overleven”."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel had om {time} weer ingeschakeld moeten worden en is dat niet: "
"„Herstellen” in „Overleven”."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel uitgeschakeld door omega-tail tot {time}, daarna automatisch weer "
"ingeschakeld."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale meldt: {message}"

msgid "ajout manuel"
msgstr "handmatig toegevoegd"

msgid "import"
msgstr "import"

msgid "écran Attaques"
msgstr "scherm Aanvallen"

msgid "avant les dates"
msgstr "vóór de datums"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Temperatuur van {temperature:.0f} °C (drempel {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"tailscaled boven {threshold:.0f} % van een kern sinds {seconds} s (gemiddeld"
" {average:.0f} %)."

msgid "cible non prise en charge"
msgstr "doel niet ondersteund"

msgid "nom de machine inattendu"
msgstr "onverwachte machinenaam"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "geen enkele poort staat open naar internet (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "meerdere Funnel-poorten: de slagboom beschermt er voorlopig maar één"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "Funnel loopt al via een slagboom (TCP + PROXY v2)"

msgid "seule une publication HTTPS avec le chemin « / » est prise en charge"
msgstr "alleen een HTTPS-publicatie met het pad „/” wordt ondersteund"

msgid "Chrome, Edge, Firefox récent"
msgstr "Chrome, Edge, recente Firefox"

msgid "Firefox (ancien)"
msgstr "Firefox (oud)"

msgid "empreinte"
msgstr "vingerafdruk"

msgid "hébergeur"
msgstr "hoster"

msgid "pays"
msgstr "land"

msgid "Identité"
msgstr "Identiteit"

msgid "Réseau"
msgstr "Netwerk"

msgid "Sortie"
msgstr "Exit"

msgid "Services Tailscale"
msgstr "Tailscale-diensten"

msgid "Opérateur"
msgstr "Operator"

msgid "Nom de la machine"
msgstr "Naam van de machine"

msgid ""
"Nom dans le tailnet (vide : celui du système). Change aussi l'adresse "
"*.ts.net : les liens publiés et le certificat suivent."
msgstr ""
"Naam in het tailnet (leeg: die van het systeem). Verandert ook het adres "
"*.ts.net: gepubliceerde links en certificaat volgen."

msgid "ex. serveur-maison"
msgstr "bijv. thuisserver"

msgid "Surnom du compte"
msgstr "Bijnaam van het account"

msgid ""
"Surnom du compte en cours, pour le reconnaître dans « Changer de compte »."
msgstr ""
"Bijnaam van het huidige account, om het te herkennen in „Van account "
"wisselen”."

msgid "ex. maison"
msgstr "bijv. thuis"

msgid "Accepter les routes"
msgstr "Routes accepteren"

msgid ""
"Utiliser les sous-réseaux annoncés par les autres machines. À éviter sur une"
" machine du même réseau local que le routeur qui l'annonce."
msgstr ""
"De subnetten gebruiken die door andere machines worden aangekondigd. "
"Vermijden op een machine in hetzelfde lokale netwerk als de router die het "
"aankondigt."

msgid "Accepter le DNS du tailnet"
msgstr "DNS van het tailnet accepteren"

