msgid ""
msgstr ""
"Project-Id-Version: omega-tail\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr ""
"omega-tail: कोई इंटरैक्टिव टर्मिनल नहीं; « omega-tail etat » का उपयोग करें।"

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "मशीन का नाम अज्ञात: क्या Tailscale कनेक्टेड है?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "प्रमाणपत्र अस्वीकृत ({error})। क्या आप Tailscale के ऑपरेटर हैं?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "प्रमाणपत्र नवीनीकृत, लेकिन गेट ने उसे नहीं लिया ({error})।"

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "{name} का प्रमाणपत्र अद्यतन है।"

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "प्रकाशन समर्थित नहीं: {reason}।"

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "प्रकाशन पढ़ा नहीं जा सका ({error})।"

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy इंस्टॉल नहीं है: पहले « HAProxy इंस्टॉल करें »।"

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "HAProxy ने गेट का कॉन्फ़िगरेशन अस्वीकार किया: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "प्रमाणपत्र का नवीनीकरण शेड्यूल नहीं हुआ (crontab: {error})।"

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "गेट तैयार: प्रमाणपत्र, सूचियाँ और कॉन्फ़िगरेशन जाँचे गए।"

msgid "La porte protège déjà Funnel."
msgstr "गेट पहले से Funnel की रक्षा कर रहा है।"

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "गेट स्थानीय रूप से जवाब नहीं दे रहा ({detail}): कुछ भी नहीं बदला गया।"

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "स्विच अस्वीकृत ({error}): मूल प्रकाशन वापस लगाया गया।"

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel गेट से होकर जाता है: सार्वजनिक परीक्षण सफल ({detail})।"

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "सार्वजनिक परीक्षण विफल ({detail}): मूल प्रकाशन वापस लगाया गया।"

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "गेट Funnel की रक्षा नहीं कर रहा: वापस लगाने को कुछ नहीं।"

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "मूल प्रकाशन अधूरा ({errors}): बैकअप {path} में रखा गया।"

msgid "Publication d'origine remise, à l'identique."
msgstr "मूल प्रकाशन हूबहू वापस लगाया गया।"

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "नियम सहेजे गए; वे सक्रिय करने पर लागू होंगे।"

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "नियम सहेजे गए, कॉन्फ़िगरेशन दोबारा नहीं बना ({error})।"

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "HAProxy ने नियम अस्वीकार किए ({error}): पुराना कॉन्फ़िगरेशन रखा गया।"

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "नियम लिखे गए, रीलोड संभव नहीं ({error})।"

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "नियम चलते-चलते लागू किए गए ({mode} मोड)।"

msgid "Regroupements indisponibles."
msgstr "समूहन उपलब्ध नहीं।"

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"फ़िंगरप्रिंट सीखना जारी है (अभी {days} दिन): अंत तक समूहन निरीक्षण में रहते "
"हैं; उसके बाद « लागू » संभव होगा।"

msgid "appliqués"
msgstr "लागू"

msgid "en observation"
msgstr "निरीक्षण में"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "समूहन चलते-चलते लागू किए गए ({mode})।"

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"सीखना फिर से शुरू: समूहन {days} दिन के सीखने के लिए फिर से निरीक्षण में।"

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"AS / देश डेटाबेस: बहुत लंबा (15 मिनट से अधिक), छोड़ दिया गया; पुराना बना "
"रहता है।"

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"ब्लैकलिस्ट भरी हुई है ({max} प्रविष्टियाँ): नई जोड़ने से पहले « ब्लैकलिस्ट "
"प्रबंधन » में उसकी सफ़ाई करें या एक्सपोर्ट करें।"

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "अमान्य पता या नेटवर्क: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} tailnet का हिस्सा है: गेट हमेशा Tailscale मशीनों को अनुमति देता "
"है, इसे ब्लॉक नहीं किया जा सकता।"

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} पहले से ब्लैकलिस्ट में है (या उसके किसी नेटवर्क में)।"

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → ब्लैकलिस्ट (हटाए जाने तक अस्वीकृत)।"

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "ब्लैकलिस्ट से {count} प्रविष्टि(याँ) हटाई गईं; {left} बची हैं।"

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"इम्पोर्ट: {added} जोड़ी गईं, {duplicates} डुप्लिकेट, {tailnet} tailnet की "
"छोड़ी गईं, {invalid} अमान्य पंक्ति(याँ)।"

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"इम्पोर्ट: {added} जोड़ी गईं, {duplicates} डुप्लिकेट, {tailnet} tailnet की "
"छोड़ी गईं, {invalid} अमान्य पंक्ति(याँ), {over} {max} की सीमा से ऊपर।"

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "कोई प्रविष्टि मेल नहीं खाती: कुछ भी नहीं हटाया गया।"

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "सफ़ाई: ब्लैकलिस्ट से {count} प्रविष्टि(याँ) हटाई गईं; {left} बची हैं।"

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "अमान्य पता: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → ब्लैकलिस्ट (हटाए जाने तक अस्वीकृत), विश्वसनीय सूची से हटाया गया।"

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} विश्वसनीय है (कभी सीमित नहीं): विश्वसनीयता ब्लॉक से पहले आती है। "
"पहले इसे विश्वसनीय सूची से हटाएँ।"

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr "गेट तक पहुँच नहीं ({error}): गेट बंद होने पर अस्थायी ब्लॉक संभव नहीं।"

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → {minutes} मिनट के लिए ब्लॉक (अस्थायी ब्लॉक)।"

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr ""
"{address} → अब भी अस्वीकृत: यह ब्लैकलिस्ट के किसी नेटवर्क का हिस्सा है।"

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} → अनुमत (नियमों के अधीन), ब्लैकलिस्ट से हटाया गया।"

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr "{address} → अनुमत (नियमों के अधीन), अस्थायी ब्लॉक हटाया गया।"

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} → विश्वसनीय (कभी सीमित नहीं), ब्लैकलिस्ट से हटाया गया।"

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → विश्वसनीय (कभी सीमित नहीं)।"

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → हमेशा अनुमत: यह tailnet का हिस्सा है।"

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → अनुमत (नियमों के अधीन)।"

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "सीखना फिर से शुरू: संदर्भ के गिने जाने से पहले {days} दिन।"

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr "AS / देश डेटाबेस अपडेट नहीं हुआ ({error}): पुराना बना रहता है।"

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr "AS / देश डेटाबेस अद्यतन ({countries} देश रेंज, {asns} AS रेंज)।"

msgid "habituelle"
msgstr "सामान्य"

msgid "limité en attaque"
msgstr "हमले में सीमित"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr "Funnel सर्किट ब्रेकर द्वारा बंद है: पहले उसे बहाल करें (उत्तरजीविता)।"

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Tailscale द्वारा अस्वीकृत ({error}): कुछ नहीं बदला।"

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "बदलाव संभव नहीं ({error}): पिछला प्रकाशन वापस लगाया गया।"

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "प्रकाशन अधूरा ({error}): बैकअप {path} बहाल करें।"

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "जोड़ना अस्वीकृत: {reason}।"

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "प्रकाशित: {kind} {port}{path} → {target} ({who})।"

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"यह पोर्ट गेट से होकर जाता है: पहले « संरक्षण निष्क्रिय करें » (Funnel "
"फ़ायरवॉल)।"

msgid "Ce point n'est plus publié."
msgstr "यह बिंदु अब प्रकाशित नहीं है।"

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "हटाया गया: {kind} {port}{path}।"

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "बैकअप पढ़ा नहीं जा सका ({error})।"

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"संरक्षण सक्रिय है: पहले « संरक्षण निष्क्रिय करें » (Funnel फ़ायरवॉल), फिर "
"बहाल करें।"

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"यह बैकअप गेट से होकर जाता है, जो बंद है: « संरक्षण सक्रिय करें » (Funnel "
"फ़ायरवॉल) इसे ठीक से फिर बनाता है।"

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "{when} का बैकअप बहाल किया गया।"

msgid "essai public indisponible"
msgstr "सार्वजनिक परीक्षण उपलब्ध नहीं"

msgid "adresse du tailnet inconnue"
msgstr "tailnet पता अज्ञात"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel अभी भी इन पोर्ट पर अनुमत है"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel पहले से omega-tail द्वारा बंद है।"

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "बंद करने को कुछ नहीं: इंटरनेट के लिए कोई पोर्ट खुला नहीं है।"

msgid "Remise en route programmée impossible ici."
msgstr "यहाँ निर्धारित पुनः-चालू संभव नहीं।"

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr "पुनः-चालू टाइमर अस्वीकृत (कोड {code}): कुछ भी बंद नहीं किया गया।"

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "बंद करना संभव नहीं ({error}): प्रकाशन वापस लगाया गया।"

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr "Funnel बंद ({ports}) {minutes} मिनट के लिए, फिर अपने-आप फिर से चालू।"

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel बंद ({ports}) जब तक आप उसे फिर से चालू न करें।"

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "बहाल करने को कुछ नहीं: Funnel omega-tail द्वारा बंद नहीं है।"

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "पुराने बंद का टाइमर: करने को कुछ नहीं।"

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "पुनः-चालू अधूरा ({errors}): बैकअप {path} में रखा गया।"

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel हूबहू फिर से चालू किया गया।"

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "इस मशीन पर Tailscale इंस्टॉल नहीं है।"

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "tailscaled सेवा जवाब नहीं दे रही (बंद या विफल)।"

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"अपडेट के बाद tailscaled रीस्टार्ट नहीं हुआ: {daemon} चल रहा है, {client} "
"इंस्टॉल है।"

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale किसी खाते के कनेक्ट होने की प्रतीक्षा में है।"

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale डिसकनेक्टेड है (« tailscale down »)।"

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "इस मशीन की कुंजी {days} दिन में समाप्त होगी।"

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr "साइट डाउन: Funnel गेट (फ़ायरवॉल) से होकर जाता है, लेकिन गेट बंद है।"

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"गेट हमला मोड में है: बहुत अधिक आने वाले कनेक्शन; शांति लौटने तक समूहन "
"(फ़िंगरप्रिंट, AS, देश) लागू रहते हैं।"

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel पोर्ट {port} पर बिना संरक्षण के प्रकाशित है: tailscaled हर कनेक्शन का"
" TLS करता है (एक बौछार मशीन को ठप कर सकती है)।"

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "उच्च तापमान: {temperature:.0f} °C।"

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled एक कोर का {cpu:.0f} % उपयोग कर रहा है।"

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"स्वचालित निगरानी सक्रिय है लेकिन अब चल नहीं रही: हमले के समय Funnel अपने-आप "
"बंद नहीं होगा।"

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"गेट की ब्लैकलिस्ट: {count} प्रविष्टियाँ (सीमा {max})। उसे एक्सपोर्ट करें, "
"फिर सबसे पुरानी की सफ़ाई करें: « हमले और निर्णय » → « ब्लैकलिस्ट प्रबंधन »।"

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"WireGuard पोर्ट का कवच अनुपस्थित: किसी अन्य टूल ने उसकी तालिका मिटा दी (nft "
"flush ruleset, फ़ायरवॉल फिर से चालू…)। यह अपने-आप दोबारा नहीं लगता: « "
"उत्तरजीविता » → « WireGuard पोर्ट का कवच » → « फिर से लगाएँ »।"

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"WireGuard पोर्ट का कवच: 3 मिनट से अधिक से स्थिति अपडेट नहीं हुई (omega-"
"bouclier-wg सेवा बंद?)।"

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"tailscaled के शुरू होने पर « tailscale up » चलता है: यदि कोई सेटिंग बदलती है"
" (ऑपरेटर, नाम, रूट…), तो Tailscale उसे अस्वीकार करेगा और tailscaled फिर से "
"शुरू नहीं होगा। « सेवा » → « स्टार्टअप ठीक करें »।"

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"tailscaled की सीमाबंदी खो गई (सेवा रीस्टार्ट हुई): « उत्तरजीविता » → « "
"सीमाबंदी लागू करें »।"

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr "tailscaled सीमाबंद नहीं है: हमले में यह सभी कोर ले सकता है।"

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "आप Tailscale के ऑपरेटर नहीं हैं: हर सेटिंग sudo माँगेगी।"

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel omega-tail द्वारा बंद (पूर्ण बंदी): « उत्तरजीविता » में मैन्युअल रूप "
"से फिर से चालू करें।"

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel को {time} पर फिर से चालू होना था और नहीं हुआ: « उत्तरजीविता » में « "
"बहाल करें »।"

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
