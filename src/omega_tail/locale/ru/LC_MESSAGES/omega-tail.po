msgstr ""
"Project-Id-Version: omega-tail\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr ""
"omega-tail: нет интерактивного терминала; используйте «omega-tail etat»."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Имя машины неизвестно: Tailscale подключён?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Сертификат отклонён ({error}). Вы оператор Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Сертификат обновлён, но шлюз его не подхватил ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Сертификат {name} актуален."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Публикация не поддерживается: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Публикация не читается ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy не установлен: сначала «Установить HAProxy»."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "HAProxy отклонил конфигурацию шлюза: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Обновление сертификата не запланировано (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Шлюз готов: сертификат, списки и конфигурация проверены."

msgid "La porte protège déjà Funnel."
msgstr "Шлюз уже защищает Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "Шлюз не отвечает локально ({detail}): ничего не переключено."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Переключение отклонено ({error}): исходная публикация возвращена."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel идёт через шлюз: публичная проверка успешна ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr ""
"Публичная проверка не удалась ({detail}): исходная публикация возвращена."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Шлюз не защищает Funnel: возвращать нечего."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Исходная публикация восстановлена не полностью ({errors}): резервная копия "
"сохранена в {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Исходная публикация возвращена в точности."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Правила сохранены; они применятся при включении."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Правила сохранены, конфигурация не пересоздана ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "HAProxy отклонил правила ({error}): старая конфигурация сохранена."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Правила записаны, перезагрузка невозможна ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Правила применены на лету (режим {mode})."

msgid "Regroupements indisponibles."
msgstr "Группировка недоступна."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Идёт обучение отпечаткам (ещё {days} дн.): группировка остаётся в наблюдении"
" до конца; режим «применяется» станет возможен после."

msgid "appliqués"
msgstr "применяется"

msgid "en observation"
msgstr "в наблюдении"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Группировка применена на лету ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Обучение начато заново: группировка возвращена в наблюдение на {days} дн. "
"обучения."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"База AS / стран: слишком долго (более 15 минут), отменено; старая база "
"остаётся."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Чёрный список заполнен ({max} записей): очистите или экспортируйте его в "
"«Управление чёрным списком», прежде чем добавлять."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Неверный адрес или сеть: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} входит в tailnet: шлюз всегда допускает машины Tailscale, "
"заблокировать её нельзя."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} уже в чёрном списке (или в одной из его сетей)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → чёрный список (отклоняется до удаления)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Из чёрного списка удалено записей: {count}; осталось {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Импорт: добавлено {added}, дубликатов {duplicates}, из tailnet отброшено "
"{tailnet}, неверных строк {invalid}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Импорт: добавлено {added}, дубликатов {duplicates}, из tailnet отброшено "
"{tailnet}, неверных строк {invalid}, сверх предела {max}: {over}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Нет подходящих записей: ничего не удалено."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Очистка: из чёрного списка удалено записей: {count}; осталось {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Неверный адрес: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → чёрный список (отклоняется до удаления), удалён из доверенных."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} в доверенных (никогда не ограничивается): доверие важнее "
"блокировки. Сначала удалите его из доверенных."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Шлюз недоступен ({error}): временная блокировка невозможна, шлюз остановлен."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → заблокирован на {minutes} мин (временная блокировка)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → всегда отклоняется: входит в сеть из чёрного списка."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} → допущен (по правилам), удалён из чёрного списка."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr "{address} → допущен (по правилам), временная блокировка снята."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr ""
"{address} → доверенный (никогда не ограничивается), удалён из чёрного "
"списка."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → доверенный (никогда не ограничивается)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → всегда допускается: входит в tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → допущен (по правилам)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr ""
"Обучение начато заново: {days} дн. до того, как эталон начнёт учитываться."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr "База AS / стран не обновлена ({error}): старая остаётся."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"База AS / стран актуальна (диапазонов стран: {countries}, диапазонов AS: "
"{asns})."

msgid "habituelle"
msgstr "обычный"

msgid "limité en attaque"
msgstr "ограничен при атаке"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel отключён предохранителем: сначала восстановите его («Живучесть»)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Отклонено Tailscale ({error}): ничего не изменилось."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Изменение невозможно ({error}): прежняя публикация возвращена."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Публикация неполная ({error}): восстановите резервную копию {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Добавление отклонено: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Опубликовано: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Этот порт идёт через шлюз: сначала «Отключить защиту» («Межсетевой экран "
"Funnel»)."

msgid "Ce point n'est plus publié."
msgstr "Эта точка больше не опубликована."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Снято: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Резервная копия не читается ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"Защита активна: сначала «Отключить защиту» («Межсетевой экран Funnel»), "
"затем восстановите."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Эта резервная копия идёт через шлюз, а он остановлен: «Включить защиту» "
"(«Межсетевой экран Funnel») корректно его пересоздаст."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Резервная копия от {when} восстановлена."

msgid "essai public indisponible"
msgstr "публичная проверка недоступна"

msgid "adresse du tailnet inconnue"
msgstr "адрес tailnet неизвестен"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel всё ещё разрешён на портах"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel уже отключён omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Нечего отключать: ни один порт не открыт в Интернет."

msgid "Remise en route programmée impossible ici."
msgstr "Запланированное восстановление здесь невозможно."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr "Таймер восстановления отклонён (код {code}): ничего не отключено."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Отключение невозможно ({error}): публикация возвращена."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel отключён ({ports}) на {minutes} мин, затем будет восстановлен "
"автоматически."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel отключён ({ports}) до восстановления вами."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Нечего восстанавливать: Funnel не отключён omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Таймер прежнего отключения: делать нечего."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Восстановление неполное ({errors}): резервная копия сохранена в {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel восстановлен в точности."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale не установлен на этой машине."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Служба tailscaled не отвечает (остановлена или в ошибке)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled не перезапущен после обновления: работает {daemon}, установлен "
"{client}."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale ждёт подключения учётной записи."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale отключён («tailscale down»)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "Ключ этой машины истекает через {days} дн."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Сайт недоступен: Funnel идёт через шлюз (межсетевой экран), но шлюз "
"остановлен."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Шлюз в РЕЖИМЕ АТАКИ: слишком много входящих соединений; группировка "
"(отпечатки, AS, страны) применяется до возвращения спокойствия."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel опубликован без защиты на порту {port}: tailscaled выполняет TLS для "
"каждого соединения (всплеск может перегрузить машину)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Высокая температура: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled потребляет {cpu:.0f} % одного ядра."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"Автоматический надзор включён, но больше не работает: Funnel не будет "
"отключён сам при атаке."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Чёрный список шлюза: {count} записей (предел {max}). Экспортируйте его, "
"затем удалите самые старые: «Атаки и решения» → «Управление чёрным списком»."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Щит порта WireGuard ОТСУТСТВУЕТ: другой инструмент удалил его таблицу (nft "
"flush ruleset, перезапуск межсетевого экрана…). Сам он не ставится заново: "
"«Живучесть» → «Щит порта WireGuard» → «Поставить заново»."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Щит порта WireGuard: состояние не обновлялось более 3 минут (служба omega-"
"bouclier-wg остановлена?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Запуск tailscaled выполняет «tailscale up»: если какая-то настройка "
"изменится (оператор, имя, маршруты…), Tailscale её отклонит и tailscaled "
"больше не перезапустится. «Служба» → «Исправить запуск»."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Ограничение ресурсов tailscaled потеряно (служба перезапустилась): "
"«Живучесть» → «Применить ограничение»."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr "tailscaled не ограничен: при атаке он может занять все ядра."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "Вы не оператор Tailscale: каждая настройка будет требовать sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel отключён omega-tail (полное отключение): восстановление вручную, в "
"«Живучести»."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel должен был восстановиться в {time}, но не восстановлен: "
"«Восстановить» в «Живучести»."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel отключён omega-tail до {time}, затем будет восстановлен "
"автоматически."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale сообщает: {message}"

msgid "ajout manuel"
msgstr "добавлено вручную"

msgid "import"
msgstr "импорт"

msgid "écran Attaques"
msgstr "экран «Атаки»"

msgid "avant les dates"
msgstr "до введения дат"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Температура {temperature:.0f} °C (порог {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"tailscaled выше {threshold:.0f} % одного ядра уже {seconds} с (в среднем "
"{average:.0f} %)."

msgid "cible non prise en charge"
msgstr "цель не поддерживается"

msgid "nom de machine inattendu"
msgstr "неожиданное имя машины"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "ни один порт не открыт в Интернет (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "несколько портов Funnel: шлюз пока защищает только один"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "Funnel уже идёт через шлюз (TCP + PROXY v2)"

