msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: ไม่มีเทอร์มินัลแบบโต้ตอบ; ใช้ « omega-tail etat »"

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "ไม่ทราบชื่อเครื่อง: Tailscale เชื่อมต่ออยู่หรือไม่?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "ใบรับรองถูกปฏิเสธ ({error}) คุณเป็นผู้ควบคุมของ Tailscale หรือไม่?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "ต่ออายุใบรับรองแล้ว แต่ประตูยังไม่ได้นำไปใช้ ({error})"

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "ใบรับรองของ {name} เป็นปัจจุบัน"

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "ไม่รองรับการเผยแพร่นี้: {reason}"

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "อ่านการเผยแพร่ไม่ได้ ({error})"

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "ยังไม่ได้ติดตั้ง HAProxy: ใช้ « ติดตั้ง HAProxy » ก่อน"

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "HAProxy ปฏิเสธการกำหนดค่าของประตู: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "ไม่ได้ตั้งเวลาการต่ออายุใบรับรอง (crontab: {error})"

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "ประตูพร้อมแล้ว: ตรวจสอบใบรับรอง รายการ และการกำหนดค่าแล้ว"

msgid "La porte protège déjà Funnel."
msgstr "ประตูป้องกัน Funnel อยู่แล้ว"

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "ประตูไม่ตอบสนองภายในเครื่อง ({detail}): ไม่มีการสลับใด ๆ"

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "การสลับถูกปฏิเสธ ({error}): คืนการเผยแพร่เดิมแล้ว"

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel ผ่านประตูแล้ว: ทดสอบสาธารณะสำเร็จ ({detail})"

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "ทดสอบสาธารณะล้มเหลว ({detail}): คืนการเผยแพร่เดิมแล้ว"

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "ประตูไม่ได้ป้องกัน Funnel: ไม่มีอะไรต้องคืน"

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "การเผยแพร่เดิมไม่ครบถ้วน ({errors}): เก็บสำรองไว้ที่ {path}"

msgid "Publication d'origine remise, à l'identique."
msgstr "คืนการเผยแพร่เดิมแล้ว เหมือนเดิมทุกประการ"

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "บันทึกกฎแล้ว; จะมีผลเมื่อเปิดการป้องกัน"

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "บันทึกกฎแล้ว แต่ไม่ได้สร้างการกำหนดค่าใหม่ ({error})"

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "HAProxy ปฏิเสธกฎ ({error}): เก็บการกำหนดค่าเดิมไว้"

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "เขียนกฎแล้ว แต่โหลดใหม่ไม่ได้ ({error})"

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "ใช้กฎขณะทำงานแล้ว (โหมด {mode})"

msgid "Regroupements indisponibles."
msgstr "การจัดกลุ่มไม่พร้อมใช้งาน"

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"กำลังเรียนรู้ลายนิ้วมือ (เหลืออีก {days} วัน): "
"การจัดกลุ่มยังอยู่ในโหมดสังเกตการณ์จนกว่าจะเสร็จ; จากนั้นจึงเลือก « "
"บังคับใช้ » ได้"

msgid "appliqués"
msgstr "บังคับใช้"

msgid "en observation"
msgstr "สังเกตการณ์อยู่"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "ใช้การจัดกลุ่มขณะทำงานแล้ว ({mode})"

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"เริ่มการเรียนรู้ใหม่: การจัดกลุ่มกลับเป็นโหมดสังเกตการณ์ตลอด {days} "
"วันของการเรียนรู้"

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"ฐานข้อมูล AS / ประเทศ: ใช้เวลานานเกินไป (เกิน 15 นาที) จึงยกเลิก; "
"ฐานข้อมูลเดิมยังใช้อยู่"

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
