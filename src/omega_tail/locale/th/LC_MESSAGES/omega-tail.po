msgstr "Funnel ถูกตัด"

msgid "Funnel fermé"
msgstr "Funnel ปิด"

msgid "Pare-feu actif · attaque"
msgstr "ไฟร์วอลล์ใช้งาน · โจมตี"

msgid "Pare-feu actif"
msgstr "ไฟร์วอลล์ใช้งาน"

msgid "Pare-feu arrêté"
msgstr "ไฟร์วอลล์หยุด"

msgid "Pare-feu inactif"
msgstr "ไฟร์วอลล์ไม่ทำงาน"

msgid "Veille active"
msgstr "เฝ้าระวังใช้งาน"

msgid "Veille arrêtée"
msgstr "เฝ้าระวังหยุด"

msgid "Veille inactive"
msgstr "เฝ้าระวังไม่ทำงาน"

