msgid ""
"  plafond CPU {quota} · poids {weight} · cœurs {cpus} · priorité {nice}"
msgstr "  CPU 상한 {quota} · 가중치 {weight} · 코어 {cpus} · 우선순위 {nice}"

msgid "tous"
msgstr "전체"

