msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: لا توجد طرفية تفاعلية؛ استخدم « omega-tail etat »."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "اسم الجهاز غير معروف: هل Tailscale متصل؟"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "رُفضت الشهادة ({error}). هل أنت مشغّل Tailscale؟"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "جُدّدت الشهادة، لكن البوابة لم تأخذها ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "شهادة {name} محدّثة."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "النشر غير مدعوم: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "تعذّرت قراءة النشر ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy غير مثبّت: « تثبيت HAProxy » أولًا."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "رفض HAProxy إعدادات البوابة: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "لم تُجدوَل عملية تجديد الشهادة (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "البوابة جاهزة: تم التحقق من الشهادة والقوائم والإعدادات."

msgid "La porte protège déjà Funnel."
msgstr "البوابة تحمي Funnel بالفعل."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "البوابة لا تستجيب محليًا ({detail}): لم يُحوَّل شيء."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "رُفض التحويل ({error}): أُعيد النشر الأصلي."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "يمرّ Funnel عبر البوابة: نجح الاختبار العام ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "فشل الاختبار العام ({detail}): أُعيد النشر الأصلي."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "البوابة لا تحمي Funnel: لا شيء لإعادته."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "النشر الأصلي غير مكتمل ({errors}): حُفظت النسخة الاحتياطية في {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "أُعيد النشر الأصلي كما كان تمامًا."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "حُفظت القواعد؛ ستُطبَّق عند التفعيل."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "حُفظت القواعد، ولم تُعَد توليد الإعدادات ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr "رفض HAProxy القواعد ({error}): أُبقيت الإعدادات القديمة."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "كُتبت القواعد، وتعذّرت إعادة التحميل ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "طُبّقت القواعد مباشرةً (الوضع {mode})."

msgid "Regroupements indisponibles."
msgstr "التجميعات غير متاحة."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"تعلّم البصمات جارٍ (باقٍ {days} يوم): تبقى التجميعات في المراقبة حتى "
"النهاية؛ وسيصبح « مطبَّقة » ممكنًا بعد ذلك."

msgid "appliqués"
msgstr "مطبَّقة"

msgid "en observation"
msgstr "في المراقبة"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "طُبّقت التجميعات مباشرةً ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"أُعيد بدء التعلّم: أُعيدت التجميعات إلى المراقبة طوال {days} يوم من التعلّم."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"قاعدة AS / البلدان: استغرقت وقتًا طويلًا جدًا (أكثر من 15 دقيقة)، فأُلغيت؛ "
"وتبقى القديمة في مكانها."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"القائمة السوداء ممتلئة ({max} إدخال): نظّفها أو صدّرها في « إدارة القائمة "
"السوداء » قبل إضافة المزيد."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "عنوان أو شبكة غير صالحة: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} جزء من tailnet: البوابة تسمح دائمًا بأجهزة Tailscale، ولا يمكن "
"حظره."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} موجود بالفعل في القائمة السوداء (أو في إحدى شبكاتها)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} ← القائمة السوداء (مرفوض حتى الإزالة)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "أُزيل {count} إدخال من القائمة السوداء؛ ويتبقى {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"الاستيراد: أُضيف {added}، {duplicates} مكرّر، استُبعد {tailnet} من tailnet، "
"{invalid} سطر غير صالح."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"الاستيراد: أُضيف {added}، {duplicates} مكرّر، استُبعد {tailnet} من tailnet، "
"{invalid} سطر غير صالح، {over} فوق الحد الأقصى {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "لا يطابق أي إدخال: لم يُزَل شيء."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "التنظيف: أُزيل {count} إدخال من القائمة السوداء؛ ويتبقى {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "عنوان غير صالح: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr "{address} ← القائمة السوداء (مرفوض حتى الإزالة)، وأُزيل من الثقة."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} في الثقة (لا يُقيَّد أبدًا): الثقة تسبق الحظر. أزله من الثقة "
"أولًا."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"تعذّر الوصول إلى البوابة ({error}): الحظر المؤقت غير ممكن والبوابة متوقفة."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} ← محظور {minutes} دقيقة (حظر مؤقت)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} ← مرفوض دائمًا: إنه جزء من شبكة في القائمة السوداء."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} ← مسموح (خاضع للقواعد)، وأُزيل من القائمة السوداء."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr "{address} ← مسموح (خاضع للقواعد)، ورُفع الحظر المؤقت."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} ← ثقة (لا يُقيَّد أبدًا)، وأُزيل من القائمة السوداء."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} ← ثقة (لا يُقيَّد أبدًا)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} ← مسموح دائمًا: إنه جزء من tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} ← مسموح (خاضع للقواعد)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "أُعيد بدء التعلّم: {days} يوم قبل أن يُعتمد المرجع."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr "لم تُحدَّث قاعدة AS / البلدان ({error}): تبقى القديمة في مكانها."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr "قاعدة AS / البلدان محدّثة ({countries} نطاق بلدان، {asns} نطاق AS)."

msgid "habituelle"
msgstr "معتادة"

msgid "limité en attaque"
msgstr "مقيَّد في الهجوم"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr "Funnel مقطوع بقاطع الدائرة: استعده أولًا (البقاء)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "رفضه Tailscale ({error}): لم يتغيّر شيء."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "التغيير غير ممكن ({error}): أُعيد النشر السابق."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "النشر غير مكتمل ({error}): استعد النسخة الاحتياطية {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "رُفضت الإضافة: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "نُشر: {kind} {port}{path} ← {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"هذا المنفذ يمرّ عبر البوابة: « تعطيل الحماية » (جدار حماية Funnel) أولًا."

msgid "Ce point n'est plus publié."
msgstr "هذه النقطة لم تعد منشورة."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "سُحب: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "تعذّرت قراءة النسخة الاحتياطية ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"الحماية مفعّلة: « تعطيل الحماية » (جدار حماية Funnel) أولًا، ثم الاستعادة."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"هذه النسخة الاحتياطية تمرّ عبر البوابة المتوقفة: « تفعيل الحماية » (جدار "
"حماية Funnel) يعيد إنشاءها بشكل سليم."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "استُعيدت النسخة الاحتياطية بتاريخ {when}."

msgid "essai public indisponible"
msgstr "الاختبار العام غير متاح"

msgid "adresse du tailnet inconnue"
msgstr "عنوان tailnet غير معروف"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel لا يزال مسموحًا على المنافذ"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel مقطوع بالفعل بواسطة omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "لا شيء لقطعه: لا يوجد منفذ مفتوح على الإنترنت."

msgid "Remise en route programmée impossible ici."
msgstr "إعادة التشغيل المجدولة غير ممكنة هنا."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr "رُفض مؤقّت إعادة التشغيل (الرمز {code}): لم يُقطع شيء."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "القطع غير ممكن ({error}): أُعيد النشر."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr "قُطع Funnel ({ports}) لمدة {minutes} دقيقة، ثم يُعاد تشغيله تلقائيًا."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "قُطع Funnel ({ports}) حتى تعيد تشغيله بنفسك."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "لا شيء لاستعادته: Funnel ليس مقطوعًا بواسطة omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "مؤقّت قطع قديم: لا شيء للقيام به."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"إعادة التشغيل غير مكتملة ({errors}): حُفظت النسخة الاحتياطية في {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "أُعيد تشغيل Funnel كما كان تمامًا."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale غير مثبّت على هذا الجهاز."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "خدمة tailscaled لا تستجيب (متوقفة أو فاشلة)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"لم يُعَد تشغيل tailscaled بعد التحديث: {daemon} قيد التشغيل، و{client} "
"مثبّت."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale ينتظر اتصال حساب."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale غير متصل (« tailscale down »)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "مفتاح هذا الجهاز ينتهي خلال {days} يوم."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"الموقع معطّل: Funnel يمرّ عبر البوابة (جدار الحماية)، لكن البوابة متوقفة."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"البوابة في وضع الهجوم: اتصالات واردة كثيرة جدًا؛ تُطبَّق التجميعات (البصمات،"
" AS، البلدان) حتى عودة الهدوء."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel منشور بلا حماية على المنفذ {port}: يتولى tailscaled TLS لكل اتصال (قد"
" تُشبع دفعةٌ واحدة الجهاز)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "حرارة مرتفعة: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "يستهلك tailscaled {cpu:.0f} % من نواة واحدة."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"الحراسة التلقائية مفعّلة لكنها لم تعد تعمل: لن يُقطع Funnel تلقائيًا عند "
"الهجوم."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"القائمة السوداء للبوابة: {count} إدخال (الحد الأقصى {max}). صدّرها ثم نظّف "
"الأقدم: « الهجمات والقرارات » ← « إدارة القائمة السوداء »."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"درع منفذ WireGuard غائب: أداة أخرى مسحت جدوله (nft flush ruleset، إعادة "
"تشغيل جدار الحماية…). لا يُعاد وضعه تلقائيًا: « البقاء » ← « درع منفذ "
"WireGuard » ← « إعادة الوضع »."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"درع منفذ WireGuard: لم تُحدَّث الحالة منذ أكثر من 3 دقائق (خدمة omega-"
"bouclier-wg متوقفة؟)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"تشغيل tailscaled يُطلق « tailscale up »: إذا تغيّر إعداد (المشغّل، الاسم، "
"المسارات…)، سيرفضه Tailscale ولن يُعاد تشغيل tailscaled. « الخدمة » ← « "
"إصلاح بدء التشغيل »."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"فُقد احتواء tailscaled (أُعيد تشغيل الخدمة): « البقاء » ← « تطبيق الاحتواء "
"»."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr "tailscaled غير محتوى: عند الهجوم، قد يستولي على كل الأنوية."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "لست مشغّل Tailscale: كل إعداد سيطلب sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel مقطوع بواسطة omega-tail (قطع كامل): إعادة التشغيل يدويًا، في « البقاء"
" »."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"كان يجب إعادة تشغيل Funnel عند {time} ولم يحدث ذلك: « استعادة » في « البقاء "
"»."

#, python-brace-format
msgid ""
