msgid ""
msgstr ""
"Project-Id-Version: omega-tail\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: no hay terminal interactivo; use «omega-tail etat»."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Nombre de la máquina desconocido: ¿está Tailscale conectado?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Certificado rechazado ({error}). ¿Es usted operador de Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Certificado renovado, pero la puerta no lo ha recargado ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Certificado de {name} al día."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Publicación no admitida: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Publicación ilegible ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy no está instalado: primero «Instalar HAProxy»."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Configuración de la puerta rechazada por HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Renovación del certificado no programada (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Puerta lista: certificado, listas y configuración verificados."

msgid "La porte protège déjà Funnel."
msgstr "La puerta ya protege Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "La puerta no responde en local ({detail}): no se ha conmutado nada."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Conmutación rechazada ({error}): publicación original restablecida."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel pasa por la puerta: prueba pública superada ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "Prueba pública fallida ({detail}): publicación original restablecida."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "La puerta no protege Funnel: nada que restablecer."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Publicación original incompleta ({errors}): copia de seguridad conservada en"
" {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Publicación original restablecida, idéntica."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Reglas guardadas; se aplicarán al activar."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Reglas guardadas, configuración no regenerada ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Reglas rechazadas por HAProxy ({error}): se conserva la configuración "
"anterior."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Reglas escritas, recarga imposible ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Reglas aplicadas en caliente (modo {mode})."

msgid "Regroupements indisponibles."
msgstr "Agrupaciones no disponibles."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Aprendizaje de huellas en curso (quedan {days} día(s)): las agrupaciones "
"permanecen en observación hasta el final; «aplicadas» será posible después."

msgid "appliqués"
msgstr "aplicadas"

msgid "en observation"
msgstr "en observación"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Agrupaciones aplicadas en caliente ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Aprendizaje reiniciado: agrupaciones de nuevo en observación durante los "
"{days} días de aprendizaje."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Base AS / país: demasiado larga (más de 15 minutos), abandonada; la anterior"
" sigue en uso."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Lista negra llena ({max} entradas): púrguela o expórtela en «Gestión de la "
"lista negra» antes de añadir más."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Dirección o red no válida: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} forma parte del tailnet: la puerta siempre admite las máquinas "
"Tailscale, no se puede bloquear."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} ya está en la lista negra (o en una de sus redes)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → lista negra (rechazada hasta su retirada)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "{count} entrada(s) retirada(s) de la lista negra; quedan {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Importación: {added} añadida(s), {duplicates} duplicada(s), {tailnet} del "
"tailnet descartada(s), {invalid} línea(s) no válida(s)."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Importación: {added} añadida(s), {duplicates} duplicada(s), {tailnet} del "
"tailnet descartada(s), {invalid} línea(s) no válida(s), {over} por encima "
"del límite de {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Ninguna entrada coincide: no se ha retirado nada."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"Purga: {count} entrada(s) retirada(s) de la lista negra; quedan {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Dirección no válida: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → lista negra (rechazada hasta su retirada), retirada de la "
"confianza."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} está en confianza (nunca limitada): la confianza va antes que el "
"bloqueo. Retírela primero de la confianza."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Puerta inalcanzable ({error}): bloqueo temporal imposible con la puerta "
"detenida."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → bloqueada {minutes} min (bloqueo temporal)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → sigue rechazada: forma parte de una red en lista negra."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr ""
"{address} → admitida (sujeta a las reglas), retirada de la lista negra."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → admitida (sujeta a las reglas), bloqueo temporal levantado."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} → confianza (nunca limitada), retirada de la lista negra."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → confianza (nunca limitada)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → siempre admitida: forma parte del tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → admitida (sujeta a las reglas)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr ""
"Aprendizaje reiniciado: {days} días antes de que la referencia cuente."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr "Base AS / país no actualizada ({error}): la anterior sigue en uso."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Base AS / país al día ({countries} rangos de países, {asns} rangos AS)."

msgid "habituelle"
msgstr "habitual"

msgid "limité en attaque"
msgstr "limitado en ataque"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel está cortado por el disyuntor: restablézcalo primero (Supervivencia)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Rechazado por Tailscale ({error}): no ha cambiado nada."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Cambio imposible ({error}): publicación anterior restablecida."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr ""
"Publicación incompleta ({error}): restaure la copia de seguridad {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Adición rechazada: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Publicado: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Este puerto pasa por la puerta: primero «Desactivar la protección» "
"(Cortafuegos Funnel)."

msgid "Ce point n'est plus publié."
msgstr "Este punto ya no está publicado."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Retirado: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Copia de seguridad ilegible ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"La protección está activa: primero «Desactivar la protección» (Cortafuegos "
"Funnel) y después restaure."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Esta copia pasa por la puerta, que está detenida: «Activar la protección» "
"(Cortafuegos Funnel) la vuelve a crear correctamente."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Copia de seguridad del {when} restaurada."

msgid "essai public indisponible"
msgstr "prueba pública no disponible"

msgid "adresse du tailnet inconnue"
msgstr "dirección del tailnet desconocida"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel aún autorizado en los puertos"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel ya está cortado por omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Nada que cortar: ningún puerto está abierto a Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Restablecimiento programado imposible aquí."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Temporizador de restablecimiento rechazado (código {code}): no se ha cortado"
" nada."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Corte imposible ({error}): la publicación se ha restablecido."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel cortado ({ports}) durante {minutes} min, y luego restablecido "
"automáticamente."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel cortado ({ports}) hasta que usted lo restablezca."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Nada que restablecer: Funnel no está cortado por omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Temporizador de un corte antiguo: nada que hacer."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Restablecimiento incompleto ({errors}): copia de seguridad conservada en "
"{path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel restablecido, idéntico."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale no está instalado en esta máquina."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "El servicio tailscaled no responde (detenido o en fallo)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled no se ha reiniciado tras la actualización: {daemon} en ejecución,"
" {client} instalado."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale espera la conexión de una cuenta."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale está desconectado («tailscale down»)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "La clave de esta máquina caduca en {days} día(s)."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Sitio caído: Funnel pasa por la puerta (cortafuegos), pero la puerta está "
"detenida."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"La puerta está en MODO ATAQUE: demasiadas conexiones entrantes; las "
"agrupaciones (huellas, AS, países) se aplican hasta que vuelva la calma."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel publicado sin protección en el puerto {port}: tailscaled hace el TLS "
"de cada conexión (una ráfaga puede saturar la máquina)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Temperatura elevada: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled consume el {cpu:.0f} % de un núcleo."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"La vigilancia automática está activada pero ya no funciona: Funnel no se "
"cortará solo bajo ataque."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Lista negra de la puerta: {count} entradas (límite {max}). Expórtela y luego"
" purgue las más antiguas: «Ataques y decisiones» → «Gestión de la lista "
"negra»."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Escudo del puerto WireGuard AUSENTE: otra herramienta ha borrado su tabla "
"(nft flush ruleset, cortafuegos relanzado…). No se vuelve a colocar solo: "
"«Supervivencia» → «Escudo del puerto WireGuard» → «Volver a colocar»."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Escudo del puerto WireGuard: estado sin actualizar desde hace más de 3 "
"minutos (¿servicio omega-bouclier-wg detenido?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"El arranque de tailscaled lanza «tailscale up»: si cambia un ajuste "
"(operador, nombre, rutas…), Tailscale lo rechazará y tailscaled ya no se "
"reiniciará. «Servicio» → «Corregir el arranque»."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Confinamiento de tailscaled perdido (el servicio se ha reiniciado): "
"«Supervivencia» → «Aplicar el confinamiento»."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled no está confinado: bajo ataque, puede acaparar todos los núcleos."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "Usted no es operador de Tailscale: cada ajuste pedirá sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel cortado por omega-tail (corte total): restablecimiento manual, en "
"«Supervivencia»."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel debía restablecerse a las {time} y no lo está: «Restablecer» en "
"«Supervivencia»."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel cortado por omega-tail hasta las {time}, y luego restablecido "
"automáticamente."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale indica: {message}"

msgid "ajout manuel"
msgstr "adición manual"

msgid "import"
msgstr "importación"

msgid "écran Attaques"
msgstr "pantalla Ataques"

msgid "avant les dates"
msgstr "anterior a las fechas"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Temperatura de {temperature:.0f} °C (umbral {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"tailscaled por encima del {threshold:.0f} % de un núcleo desde hace "
"{seconds} s (media {average:.0f} %)."

msgid "cible non prise en charge"
msgstr "destino no admitido"

msgid "nom de machine inattendu"
msgstr "nombre de máquina inesperado"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "ningún puerto está abierto a Internet (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "varios puertos Funnel: por ahora la puerta solo protege uno"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "Funnel ya pasa por una puerta (TCP + PROXY v2)"

msgid "seule une publication HTTPS avec le chemin « / » est prise en charge"
msgstr "solo se admite una publicación HTTPS con la ruta «/»"

msgid "Chrome, Edge, Firefox récent"
msgstr "Chrome, Edge, Firefox reciente"

msgid "Firefox (ancien)"
msgstr "Firefox (antiguo)"

msgid "empreinte"
msgstr "huella"

msgid "hébergeur"
msgstr "alojamiento"

msgid "pays"
msgstr "país"

msgid "Identité"
msgstr "Identidad"

msgid "Réseau"
msgstr "Red"

msgid "Sortie"
msgstr "Salida"

msgid "Services Tailscale"
msgstr "Servicios de Tailscale"

msgid "Opérateur"
msgstr "Operador"

msgid "Nom de la machine"
msgstr "Nombre de la máquina"

msgid ""
"Nom dans le tailnet (vide : celui du système). Change aussi l'adresse "
"*.ts.net : les liens publiés et le certificat suivent."
msgstr ""
"Nombre en el tailnet (vacío: el del sistema). También cambia la dirección "
"*.ts.net: los enlaces publicados y el certificado siguen el cambio."

msgid "ex. serveur-maison"
msgstr "p. ej. servidor-casa"

msgid "Surnom du compte"
msgstr "Alias de la cuenta"

msgid ""
"Surnom du compte en cours, pour le reconnaître dans « Changer de compte »."
msgstr "Alias de la cuenta actual, para reconocerla en «Cambiar de cuenta»."

msgid "ex. maison"
msgstr "p. ej. casa"

msgid "Accepter les routes"
msgstr "Aceptar las rutas"

msgid ""
"Utiliser les sous-réseaux annoncés par les autres machines. À éviter sur une"
" machine du même réseau local que le routeur qui l'annonce."
msgstr ""
"Usar las subredes anunciadas por las demás máquinas. Evítelo en una máquina "
"de la misma red local que el router que la anuncia."

msgid "Accepter le DNS du tailnet"
msgstr "Aceptar el DNS del tailnet"

msgid "MagicDNS : les noms des machines du tailnet se résolvent ici."
msgstr "MagicDNS: los nombres de las máquinas del tailnet se resuelven aquí."

msgid "Bouclier (refuser les connexions entrantes)"
msgstr "Escudo (rechazar conexiones entrantes)"

msgid ""
"Aucune machine du tailnet ne peut se connecter à celle-ci (SSH et Serve "
"compris). Funnel n'est pas concerné."
msgstr ""
"Ninguna máquina del tailnet puede conectarse a esta (SSH y Serve incluidos)."
" Funnel no se ve afectado."

msgid "Filtrage avec état"
msgstr "Filtrado con estado"

msgid ""
"Pour un routeur de sous-réseau ou un nœud de sortie : ne laisse revenir que "
"les réponses."
msgstr ""
"Para un router de subred o un nodo de salida: solo deja volver las "
"respuestas."

msgid "Mode netfilter"
msgstr "Modo netfilter"

msgid ""
"on : Tailscale gère ses règles de pare-feu ; nodivert : ses chaînes sans les"
" brancher ; off : aucune règle (à vos risques)."
