msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: nessun terminale interattivo; usa « omega-tail etat »."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Nome della macchina sconosciuto: Tailscale è connesso?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Certificato rifiutato ({error}). Sei operatore di Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Certificato rinnovato, ma il varco non l'ha ripreso ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Certificato di {name} aggiornato."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Pubblicazione non supportata: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Pubblicazione illeggibile ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy non è installato: prima « Installa HAProxy »."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Configurazione del varco rifiutata da HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Rinnovo del certificato non programmato (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Varco pronto: certificato, liste e configurazione verificati."

msgid "La porte protège déjà Funnel."
msgstr "Il varco protegge già Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "Il varco non risponde in locale ({detail}): nulla è stato commutato."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Commutazione rifiutata ({error}): pubblicazione di origine rimessa."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel passa dal varco: prova pubblica riuscita ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr ""
"Prova pubblica non riuscita ({detail}): pubblicazione di origine rimessa."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Il varco non protegge Funnel: niente da rimettere."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Pubblicazione di origine incompleta ({errors}): backup conservato in {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Pubblicazione di origine rimessa, identica."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Regole salvate; si applicheranno all'attivazione."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Regole salvate, configurazione non rigenerata ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Regole rifiutate da HAProxy ({error}): vecchia configurazione conservata."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Regole scritte, ricaricamento impossibile ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Regole applicate a caldo (modalità {mode})."

msgid "Regroupements indisponibles."
msgstr "Raggruppamenti non disponibili."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Apprendimento delle impronte in corso (ancora {days} giorni): i "
"raggruppamenti restano in osservazione fino alla fine; « applicati » sarà "
"possibile dopo."

msgid "appliqués"
msgstr "applicati"

msgid "en observation"
msgstr "in osservazione"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Raggruppamenti applicati a caldo ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Apprendimento ricominciato: raggruppamenti rimessi in osservazione per i "
"{days} giorni di apprendimento."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Database AS / paesi: troppo lungo (oltre 15 minuti), abbandonato; il vecchio"
" resta in uso."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Lista nera piena ({max} voci): pulisci o esportala in « Gestione della lista"
" nera » prima di aggiungerne altre."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Indirizzo o rete non valido: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} fa parte del tailnet: il varco ammette sempre le macchine "
"Tailscale, non può essere bloccato."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} è già nella lista nera (o in una delle sue reti)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → lista nera (rifiutato fino alla rimozione)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Voci rimosse dalla lista nera: {count}; ne restano {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Importazione: {added} aggiunte, {duplicates} duplicati, {tailnet} del "
"tailnet scartate, {invalid} righe non valide."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Importazione: {added} aggiunte, {duplicates} duplicati, {tailnet} del "
"tailnet scartate, {invalid} righe non valide, {over} oltre il tetto di "
"{max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Nessuna voce corrisponde: nulla è stato rimosso."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Pulizia: voci rimosse dalla lista nera: {count}; ne restano {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Indirizzo non valido: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → lista nera (rifiutato fino alla rimozione), rimosso dalla "
"fiducia."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} è in fiducia (mai limitato): la fiducia ha la precedenza sul "
"blocco. Rimuovilo prima dalla fiducia."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Varco irraggiungibile ({error}): blocco temporaneo impossibile, varco "
"arrestato."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → bloccato {minutes} min (blocco temporaneo)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → sempre rifiutato: fa parte di una rete in lista nera."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} → ammesso (soggetto alle regole), rimosso dalla lista nera."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → ammesso (soggetto alle regole), blocco temporaneo revocato."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr "{address} → fiducia (mai limitato), rimosso dalla lista nera."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → fiducia (mai limitato)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → sempre ammesso: fa parte del tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → ammesso (soggetto alle regole)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr ""
"Apprendimento ricominciato: {days} giorni prima che il riferimento conti."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"Database AS / paesi non aggiornato ({error}): il vecchio resta in uso."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Database AS / paesi aggiornato ({countries} intervalli paese, {asns} "
"intervalli AS)."

msgid "habituelle"
msgstr "abituale"

msgid "limité en attaque"
msgstr "limitato in attacco"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel è interrotto dall'interruttore automatico: prima ripristinalo "
"(Sopravvivenza)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Rifiutato da Tailscale ({error}): nulla è cambiato."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Modifica impossibile ({error}): pubblicazione precedente rimessa."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Pubblicazione incompleta ({error}): ripristina il backup {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Aggiunta rifiutata: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Pubblicato: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Questa porta passa dal varco: prima « Disattiva la protezione » (Firewall "
"Funnel)."

msgid "Ce point n'est plus publié."
msgstr "Questo punto non è più pubblicato."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Rimosso: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Backup illeggibile ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"La protezione è attiva: prima « Disattiva la protezione » (Firewall Funnel),"
" poi ripristina."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Questo backup passa dal varco, arrestato: « Attiva la protezione » (Firewall"
" Funnel) lo ricrea correttamente."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Backup del {when} ripristinato."

msgid "essai public indisponible"
msgstr "prova pubblica non disponibile"

msgid "adresse du tailnet inconnue"
msgstr "indirizzo del tailnet sconosciuto"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel ancora autorizzato sulle porte"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel è già interrotto da omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Niente da interrompere: nessuna porta è aperta a Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Riattivazione programmata impossibile qui."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Timer di riattivazione rifiutato (codice {code}): nulla è stato interrotto."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Interruzione impossibile ({error}): la pubblicazione è stata rimessa."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel interrotto ({ports}) per {minutes} min, poi riattivato "
"automaticamente."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel interrotto ({ports}) fino alla tua riattivazione."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Niente da ripristinare: Funnel non è interrotto da omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Timer di una vecchia interruzione: niente da fare."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Riattivazione incompleta ({errors}): backup conservato in {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel riattivato, identico."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale non è installato su questa macchina."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Il servizio tailscaled non risponde (arrestato o in errore)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled non è stato riavviato dopo l'aggiornamento: {daemon} in "
"esecuzione, {client} installato."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale attende la connessione di un account."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale è disconnesso (« tailscale down »)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "La chiave di questa macchina scade tra {days} giorni."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Sito fuori servizio: Funnel passa dal varco (firewall), ma il varco è "
"arrestato."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Il varco è in MODALITÀ ATTACCO: troppe connessioni in entrata; i "
"raggruppamenti (impronte, AS, paesi) si applicano fino al ritorno della "
"calma."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel pubblicato senza protezione sulla porta {port}: tailscaled esegue il "
"TLS di ogni connessione (una raffica può saturare la macchina)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Temperatura elevata: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled consuma il {cpu:.0f} % di un core."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"La sorveglianza automatica è attivata ma non è più in esecuzione: Funnel non"
" verrà interrotto da solo sotto attacco."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Lista nera del varco: {count} voci (tetto {max}). Esportala poi elimina le "
"più vecchie: « Attacchi e decisioni » → « Gestione della lista nera »."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Scudo della porta WireGuard ASSENTE: un altro strumento ha cancellato la sua"
" tabella (nft flush ruleset, firewall riavviato…). Non viene riapplicato da "
"solo: « Sopravvivenza » → « Scudo della porta WireGuard » → « Riapplica »."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Scudo della porta WireGuard: stato non aggiornato da oltre 3 minuti "
"(servizio omega-bouclier-wg arrestato?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"L'avvio di tailscaled lancia « tailscale up »: se un'impostazione cambia "
"(operatore, nome, rotte…), Tailscale la rifiuterà e tailscaled non si "
"riavvierà più. « Servizio » → « Correggi l'avvio »."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Confinamento di tailscaled perso (il servizio si è riavviato): « "
"Sopravvivenza » → « Applica il confinamento »."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled non è confinato: sotto attacco, può prendersi tutti i core."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "Non sei operatore di Tailscale: ogni impostazione richiederà sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel interrotto da omega-tail (interruzione totale): riattivazione "
"manuale, in « Sopravvivenza »."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel doveva essere riattivato alle {time} e non lo è: « Ripristina » in « "
"Sopravvivenza »."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel interrotto da omega-tail fino alle {time}, poi riattivato "
"automaticamente."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale segnala: {message}"

msgid "ajout manuel"
msgstr "aggiunta manuale"

msgid "import"
msgstr "importazione"

msgid "écran Attaques"
msgstr "schermata Attacchi"

msgid "avant les dates"
msgstr "prima delle date"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Temperatura di {temperature:.0f} °C (soglia {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"tailscaled oltre il {threshold:.0f} % di un core da {seconds} s (media "
"{average:.0f} %)."

msgid "cible non prise en charge"
msgstr "destinazione non supportata"

msgid "nom de machine inattendu"
msgstr "nome di macchina inatteso"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "nessuna porta è aperta a Internet (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "più porte Funnel: per ora il varco ne protegge solo una"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "Funnel passa già da un varco (TCP + PROXY v2)"

msgid "seule une publication HTTPS avec le chemin « / » est prise en charge"
msgstr "è supportata solo una pubblicazione HTTPS con il percorso « / »"

msgid "Chrome, Edge, Firefox récent"
msgstr "Chrome, Edge, Firefox recente"

msgid "Firefox (ancien)"
msgstr "Firefox (vecchio)"

msgid "empreinte"
msgstr "impronta"

msgid "hébergeur"
msgstr "hosting"

msgid "pays"
msgstr "paese"

msgid "Identité"
msgstr "Identità"

msgid "Réseau"
msgstr "Rete"

msgid "Sortie"
msgstr "Uscita"

msgid "Services Tailscale"
msgstr "Servizi Tailscale"

msgid "Opérateur"
msgstr "Operatore"

msgid "Nom de la machine"
msgstr "Nome della macchina"

msgid ""
"Nom dans le tailnet (vide : celui du système). Change aussi l'adresse "
"*.ts.net : les liens publiés et le certificat suivent."
msgstr ""
"Nome nel tailnet (vuoto: quello del sistema). Cambia anche l'indirizzo "
"*.ts.net: i link pubblicati e il certificato seguono."

msgid "ex. serveur-maison"
msgstr "es. server-casa"

msgid "Surnom du compte"
msgstr "Soprannome dell'account"

msgid ""
"Surnom du compte en cours, pour le reconnaître dans « Changer de compte »."
msgstr ""
"Soprannome dell'account in uso, per riconoscerlo in « Cambia account »."

msgid "ex. maison"
msgstr "es. casa"

msgid "Accepter les routes"
msgstr "Accetta le rotte"

msgid ""
"Utiliser les sous-réseaux annoncés par les autres machines. À éviter sur une"
" machine du même réseau local que le routeur qui l'annonce."
msgstr ""
"Usare le sottoreti annunciate dalle altre macchine. Da evitare su una "
"macchina della stessa rete locale del router che la annuncia."

msgid "Accepter le DNS du tailnet"
msgstr "Accetta il DNS del tailnet"

msgid "MagicDNS : les noms des machines du tailnet se résolvent ici."
msgstr "MagicDNS: i nomi delle macchine del tailnet si risolvono qui."

msgid "Bouclier (refuser les connexions entrantes)"
msgstr "Scudo (rifiuta le connessioni in entrata)"

msgid ""
"Aucune machine du tailnet ne peut se connecter à celle-ci (SSH et Serve "
"compris). Funnel n'est pas concerné."
msgstr ""
"Nessuna macchina del tailnet può connettersi a questa (SSH e Serve "
"compresi). Funnel non è interessato."

msgid "Filtrage avec état"
msgstr "Filtraggio con stato"

msgid ""
"Pour un routeur de sous-réseau ou un nœud de sortie : ne laisse revenir que "
"les réponses."
msgstr ""
"Per un router di sottorete o un nodo di uscita: lascia tornare solo le "
"risposte."

msgid "Mode netfilter"
msgstr "Modalità netfilter"

msgid ""
"on : Tailscale gère ses règles de pare-feu ; nodivert : ses chaînes sans les"
" brancher ; off : aucune règle (à vos risques)."
