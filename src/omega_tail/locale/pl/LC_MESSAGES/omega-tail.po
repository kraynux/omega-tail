"X-Omega-Status: validated\n"

msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr "omega-tail: brak interaktywnego terminala; użyj „omega-tail etat”."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Nieznana nazwa maszyny: czy Tailscale jest połączony?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Certyfikat odrzucony ({error}). Czy jesteś operatorem Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Certyfikat odnowiony, ale brama go nie przejęła ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Certyfikat {name} jest aktualny."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Publikacja nieobsługiwana: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Nieczytelna publikacja ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy nie jest zainstalowany: najpierw „Zainstaluj HAProxy”."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Konfiguracja bramy odrzucona przez HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Odnawianie certyfikatu niezaplanowane (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Brama gotowa: certyfikat, listy i konfiguracja sprawdzone."

msgid "La porte protège déjà Funnel."
msgstr "Brama już chroni Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr "Brama nie odpowiada lokalnie ({detail}): nic nie zostało przełączone."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Przełączenie odrzucone ({error}): przywrócono pierwotną publikację."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel przechodzi przez bramę: test publiczny udany ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "Test publiczny nieudany ({detail}): przywrócono pierwotną publikację."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Brama nie chroni Funnel: nie ma czego przywracać."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Pierwotna publikacja niekompletna ({errors}): kopia zapasowa zachowana w "
"{path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Przywrócono pierwotną publikację, bez zmian."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Reguły zapisane; zostaną zastosowane po włączeniu."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr ""
"Reguły zapisane, konfiguracja nie została wygenerowana ponownie ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Reguły odrzucone przez HAProxy ({error}): zachowano poprzednią konfigurację."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Reguły zapisane, przeładowanie niemożliwe ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Reguły zastosowane na gorąco (tryb {mode})."

msgid "Regroupements indisponibles."
msgstr "Grupowanie niedostępne."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Trwa uczenie się odcisków (jeszcze {days} dni): grupowanie pozostaje w "
"obserwacji do końca; tryb „stosowane” będzie potem możliwy."

msgid "appliqués"
msgstr "stosowane"

msgid "en observation"
msgstr "w obserwacji"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Grupowanie zastosowane na gorąco ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Uczenie się rozpoczęte od nowa: grupowanie wróciło do obserwacji na {days} "
"dni uczenia się."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Baza AS / krajów: trwało zbyt długo (ponad 15 minut), przerwano; poprzednia "
"baza pozostaje."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Czarna lista pełna ({max} wpisów): wyczyść ją lub wyeksportuj w „Zarządzanie"
" czarną listą”, zanim dodasz kolejne."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Nieprawidłowy adres lub sieć: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} należy do tailnetu: brama zawsze wpuszcza maszyny Tailscale, nie "
"można go zablokować."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} jest już na czarnej liście (lub w jednej z jej sieci)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → czarna lista (odrzucany do czasu usunięcia)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Usunięto {count} wpis(ów) z czarnej listy; pozostało {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Import: dodano {added}, duplikaty {duplicates}, pominięte z tailnetu "
"{tailnet}, nieprawidłowe wiersze {invalid}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Import: dodano {added}, duplikaty {duplicates}, pominięte z tailnetu "
"{tailnet}, nieprawidłowe wiersze {invalid}, ponad limit {max}: {over}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Żaden wpis nie pasuje: nic nie zostało usunięte."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr ""
"Czyszczenie: usunięto {count} wpis(ów) z czarnej listy; pozostało {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Nieprawidłowy adres: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → czarna lista (odrzucany do czasu usunięcia), usunięty z "
"zaufanych."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} jest zaufany (nigdy nie ograniczany): zaufanie ma pierwszeństwo "
"przed blokadą. Najpierw usuń go z zaufanych."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Brama nieosiągalna ({error}): tymczasowa blokada niemożliwa, brama "
"zatrzymana."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → zablokowany na {minutes} min (blokada tymczasowa)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr "{address} → nadal odrzucany: należy do sieci z czarnej listy."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr "{address} → wpuszczony (podlega regułom), usunięty z czarnej listy."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr "{address} → wpuszczony (podlega regułom), blokada tymczasowa zdjęta."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr ""
"{address} → zaufany (nigdy nie ograniczany), usunięty z czarnej listy."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → zaufany (nigdy nie ograniczany)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → zawsze wpuszczany: należy do tailnetu."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → wpuszczony (podlega regułom)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr ""
"Uczenie się rozpoczęte od nowa: {days} dni, zanim punkt odniesienia zacznie "
"się liczyć."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"Baza AS / krajów nie została zaktualizowana ({error}): poprzednia pozostaje."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Baza AS / krajów aktualna ({countries} zakresów krajów, {asns} zakresów AS)."

msgid "habituelle"
msgstr "zwykły"

msgid "limité en attaque"
msgstr "ograniczany podczas ataku"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel został odcięty przez bezpiecznik: najpierw go przywróć (Przetrwanie)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Odrzucone przez Tailscale ({error}): nic się nie zmieniło."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr "Zmiana niemożliwa ({error}): przywrócono poprzednią publikację."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Publikacja niekompletna ({error}): przywróć kopię zapasową {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Dodanie odrzucone: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Opublikowano: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Ten port przechodzi przez bramę: najpierw „Wyłącz ochronę” (Zapora Funnel)."

msgid "Ce point n'est plus publié."
msgstr "Ten punkt nie jest już publikowany."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Wycofano: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Nieczytelna kopia zapasowa ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"Ochrona jest aktywna: najpierw „Wyłącz ochronę” (Zapora Funnel), potem "
"przywróć."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Ta kopia zapasowa przechodzi przez bramę, która jest zatrzymana: „Włącz "
"ochronę” (Zapora Funnel) odtworzy ją poprawnie."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Przywrócono kopię zapasową z {when}."

msgid "essai public indisponible"
msgstr "test publiczny niedostępny"

msgid "adresse du tailnet inconnue"
msgstr "nieznany adres tailnetu"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel nadal dozwolony na portach"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel jest już odcięty przez omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr "Nie ma czego odcinać: żaden port nie jest otwarty na Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Zaplanowane przywrócenie nie jest tu możliwe."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Minutnik przywrócenia odrzucony (kod {code}): nic nie zostało odcięte."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr "Odcięcie niemożliwe ({error}): publikacja została przywrócona."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel odcięty ({ports}) na {minutes} min, potem przywrócony automatycznie."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel odcięty ({ports}) do czasu, aż go przywrócisz."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr "Nie ma czego przywracać: Funnel nie jest odcięty przez omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Minutnik starego odcięcia: nic do zrobienia."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Przywrócenie niekompletne ({errors}): kopia zapasowa zachowana w {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel przywrócony, bez zmian."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale nie jest zainstalowany na tej maszynie."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Usługa tailscaled nie odpowiada (zatrzymana lub w stanie błędu)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled nie został uruchomiony ponownie po aktualizacji: działa {daemon},"
" zainstalowany {client}."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale czeka na zalogowanie konta."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale jest rozłączony („tailscale down”)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "Klucz tej maszyny wygasa za {days} dni."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Strona nie działa: Funnel przechodzi przez bramę (zaporę), ale brama jest "
"zatrzymana."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Brama jest w TRYBIE ATAKU: zbyt wiele połączeń przychodzących; grupowanie "
"(odciski, AS, kraje) jest stosowane do czasu uspokojenia."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel opublikowany bez ochrony na porcie {port}: tailscaled obsługuje TLS "
"każdego połączenia (seria połączeń może przeciążyć maszynę)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Wysoka temperatura: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled zużywa {cpu:.0f} % jednego rdzenia."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"Automatyczny nadzór jest włączony, ale już nie działa: Funnel nie zostanie "
"sam odcięty podczas ataku."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Czarna lista bramy: {count} wpisów (limit {max}). Wyeksportuj ją, a potem "
"wyczyść najstarsze: „Ataki i decyzje” → „Zarządzanie czarną listą”."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Osłona portu WireGuard NIEOBECNA: inne narzędzie usunęło jej tabelę (nft "
"flush ruleset, ponownie uruchomiona zapora…). Nie zostaje założona ponownie "
"sama: „Przetrwanie” → „Osłona portu WireGuard” → „Załóż ponownie”."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Osłona portu WireGuard: stan nieaktualizowany od ponad 3 minut (usługa "
"omega-bouclier-wg zatrzymana?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Uruchomienie tailscaled wywołuje „tailscale up”: jeśli jakieś ustawienie się"
" zmieni (operator, nazwa, trasy…), Tailscale je odrzuci i tailscaled już się"
" nie uruchomi. „Usługa” → „Popraw uruchamianie”."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Ograniczenie zasobów tailscaled utracone (usługa została ponownie "
"uruchomiona): „Przetrwanie” → „Zastosuj ograniczenie”."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled nie ma ograniczenia zasobów: podczas ataku może zająć wszystkie "
"rdzenie."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr ""
"Nie jesteś operatorem Tailscale: każde ustawienie będzie wymagać sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel odcięty przez omega-tail (odcięcie całkowite): przywrócenie ręczne, w"
" „Przetrwanie”."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel miał zostać przywrócony o {time}, ale nie został: „Przywróć” w "
"„Przetrwanie”."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel odcięty przez omega-tail do {time}, potem przywrócony automatycznie."

#, python-brace-format
msgid "Tailscale signale : {message}"
msgstr "Tailscale zgłasza: {message}"

msgid "ajout manuel"
msgstr "dodane ręcznie"

msgid "import"
msgstr "import"

msgid "écran Attaques"
msgstr "ekran Ataki"

msgid "avant les dates"
msgstr "sprzed dat"

#, python-brace-format
msgid "Température de {temperature:.0f} °C (seuil {threshold:.0f} °C)."
msgstr "Temperatura {temperature:.0f} °C (próg {threshold:.0f} °C)."

#, python-brace-format
msgid ""
"tailscaled au-dessus de {threshold:.0f} % d'un cœur depuis {seconds} s "
"(moyenne {average:.0f} %)."
msgstr ""
"tailscaled powyżej {threshold:.0f} % jednego rdzenia od {seconds} s (średnio"
" {average:.0f} %)."

msgid "cible non prise en charge"
msgstr "nieobsługiwany cel"

msgid "nom de machine inattendu"
msgstr "nieoczekiwana nazwa maszyny"

msgid "aucun port n'est ouvert à Internet (Funnel)"
msgstr "żaden port nie jest otwarty na Internet (Funnel)"

msgid "plusieurs ports Funnel : la porte n'en protège qu'un pour l'instant"
msgstr "kilka portów Funnel: brama na razie chroni tylko jeden"

msgid "Funnel passe déjà par une porte (TCP + PROXY v2)"
msgstr "Funnel już przechodzi przez bramę (TCP + PROXY v2)"

msgid "seule une publication HTTPS avec le chemin « / » est prise en charge"
msgstr "obsługiwana jest tylko publikacja HTTPS ze ścieżką „/”"

msgid "Chrome, Edge, Firefox récent"
msgstr "Chrome, Edge, nowy Firefox"

msgid "Firefox (ancien)"
msgstr "Firefox (stary)"

msgid "empreinte"
msgstr "odcisk"

msgid "hébergeur"
msgstr "hosting"

msgid "pays"
msgstr "kraj"

msgid "Identité"
msgstr "Tożsamość"

msgid "Réseau"
msgstr "Sieć"

msgid "Sortie"
msgstr "Wyjście"

msgid "Services Tailscale"
msgstr "Usługi Tailscale"

msgid "Opérateur"
msgstr "Operator"

msgid "Nom de la machine"
msgstr "Nazwa maszyny"

msgid ""
"Nom dans le tailnet (vide : celui du système). Change aussi l'adresse "
"*.ts.net : les liens publiés et le certificat suivent."
msgstr ""
"Nazwa w tailnecie (puste: nazwa systemu). Zmienia też adres *.ts.net: "
