msgid ""
"omega-tail : pas de terminal interactif ; utilisez « omega-tail etat »."
msgstr ""
"omega-tail: tidak ada terminal interaktif; gunakan « omega-tail etat »."

msgid "Nom de la machine inconnu : Tailscale est-il connecté ?"
msgstr "Nama mesin tidak diketahui: apakah Tailscale terhubung?"

#, python-brace-format
msgid "Certificat refusé ({error}). Êtes-vous opérateur de Tailscale ?"
msgstr "Sertifikat ditolak ({error}). Apakah Anda operator Tailscale?"

#, python-brace-format
msgid "Certificat renouvelé, mais la porte ne l'a pas repris ({error})."
msgstr "Sertifikat diperbarui, tetapi gerbang tidak memuatnya ({error})."

#, python-brace-format
msgid "Certificat de {name} à jour."
msgstr "Sertifikat {name} sudah mutakhir."

#, python-brace-format
msgid "Publication non prise en charge : {reason}."
msgstr "Publikasi tidak didukung: {reason}."

#, python-brace-format
msgid "Publication illisible ({error})."
msgstr "Publikasi tidak terbaca ({error})."

msgid "HAProxy n'est pas installé : « Installer HAProxy » d'abord."
msgstr "HAProxy belum terpasang: « Pasang HAProxy » terlebih dahulu."

#, python-brace-format
msgid "Configuration de la porte refusée par HAProxy : {error}"
msgstr "Konfigurasi gerbang ditolak oleh HAProxy: {error}"

#, python-brace-format
msgid "Renouvellement du certificat non programmé (crontab : {error})."
msgstr "Pembaruan sertifikat tidak terjadwal (crontab: {error})."

msgid "Porte prête : certificat, listes et configuration vérifiés."
msgstr "Gerbang siap: sertifikat, daftar, dan konfigurasi sudah diperiksa."

msgid "La porte protège déjà Funnel."
msgstr "Gerbang sudah melindungi Funnel."

#, python-brace-format
msgid "La porte ne répond pas en local ({detail}) : rien n'a été basculé."
msgstr ""
"Gerbang tidak merespons secara lokal ({detail}): tidak ada yang dialihkan."

#, python-brace-format
msgid "Bascule refusée ({error}) : publication d'origine remise."
msgstr "Peralihan ditolak ({error}): publikasi asli dipulihkan."

#, python-brace-format
msgid "Funnel passe par la porte : essai public réussi ({detail})."
msgstr "Funnel melewati gerbang: uji publik berhasil ({detail})."

#, python-brace-format
msgid "Essai public échoué ({detail}) : publication d'origine remise."
msgstr "Uji publik gagal ({detail}): publikasi asli dipulihkan."

msgid "La porte ne protège pas Funnel : rien à remettre."
msgstr "Gerbang tidak melindungi Funnel: tidak ada yang perlu dipulihkan."

#, python-brace-format
msgid ""
"Publication d'origine incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr "Publikasi asli tidak lengkap ({errors}): cadangan disimpan di {path}."

msgid "Publication d'origine remise, à l'identique."
msgstr "Publikasi asli dipulihkan, persis seperti semula."

msgid "Règles enregistrées ; elles s'appliqueront à l'activation."
msgstr "Aturan disimpan; aturan akan diterapkan saat diaktifkan."

#, python-brace-format
msgid "Règles enregistrées, configuration non régénérée ({error})."
msgstr "Aturan disimpan, konfigurasi tidak dibuat ulang ({error})."

#, python-brace-format
msgid "Règles refusées par HAProxy ({error}) : ancienne configuration gardée."
msgstr ""
"Aturan ditolak oleh HAProxy ({error}): konfigurasi lama dipertahankan."

#, python-brace-format
msgid "Règles écrites, rechargement impossible ({error})."
msgstr "Aturan ditulis, tetapi tidak dapat dimuat ulang ({error})."

#, python-brace-format
msgid "Règles appliquées à chaud (mode {mode})."
msgstr "Aturan diterapkan langsung (mode {mode})."

msgid "Regroupements indisponibles."
msgstr "Pengelompokan tidak tersedia."

#, python-brace-format
msgid ""
"Apprentissage des empreintes en cours (encore {days} jour(s)) : les "
"regroupements restent en observation jusqu'à la fin ; « appliqués » sera "
"possible ensuite."
msgstr ""
"Pembelajaran sidik jari sedang berjalan (masih {days} hari): pengelompokan "
"tetap dalam pengamatan sampai selesai; « diterapkan » baru bisa dipilih "
"setelahnya."

msgid "appliqués"
msgstr "diterapkan"

msgid "en observation"
msgstr "dalam pengamatan"

#, python-brace-format
msgid "Regroupements appliqués à chaud ({mode})."
msgstr "Pengelompokan diterapkan langsung ({mode})."

#, python-brace-format
msgid ""
"Apprentissage recommencé : regroupements repassés en observation pour les "
"{days} jours d'apprentissage."
msgstr ""
"Pembelajaran dimulai ulang: pengelompokan kembali ke pengamatan selama "
"{days} hari pembelajaran."

msgid ""
"Base AS / pays : trop longue (plus de 15 minutes), abandonnée ; l'ancienne "
"reste en place."
msgstr ""
"Basis data AS / negara: terlalu lama (lebih dari 15 menit), dibatalkan; yang"
" lama tetap dipakai."

#, python-brace-format
msgid "{text}"
msgstr "{text}"

#, python-brace-format
msgid ""
"Liste noire pleine ({max} entrées) : purgez ou exportez-la dans « Gestion de"
" la liste noire » avant d'en ajouter."
msgstr ""
"Daftar hitam penuh ({max} entri): bersihkan atau ekspor di « Pengelolaan "
"daftar hitam » sebelum menambah lagi."

#, python-brace-format
msgid "Adresse ou réseau invalide : {text}"
msgstr "Alamat atau jaringan tidak valid: {text}"

#, python-brace-format
msgid ""
"{address} fait partie du tailnet : la porte admet toujours les machines "
"Tailscale, elle ne peut pas être bloquée."
msgstr ""
"{address} termasuk tailnet: gerbang selalu mengizinkan mesin Tailscale, jadi"
" alamat ini tidak bisa diblokir."

#, python-brace-format
msgid "{address} est déjà dans la liste noire (ou dans un de ses réseaux)."
msgstr "{address} sudah ada di daftar hitam (atau di salah satu jaringannya)."

#, python-brace-format
msgid "{address} → liste noire (refusée jusqu'au retrait)."
msgstr "{address} → daftar hitam (ditolak sampai dicabut)."

#, python-brace-format
msgid "{count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "{count} entri dicabut dari daftar hitam; tersisa {left}."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s)."
msgstr ""
"Impor: {added} ditambahkan, {duplicates} duplikat, {tailnet} dari tailnet "
"diabaikan, {invalid} baris tidak valid."

#, python-brace-format
msgid ""
"Import : {added} ajoutée(s), {duplicates} doublon(s), {tailnet} du tailnet "
"écartée(s), {invalid} ligne(s) invalide(s), {over} au-delà du plafond de "
"{max}."
msgstr ""
"Impor: {added} ditambahkan, {duplicates} duplikat, {tailnet} dari tailnet "
"diabaikan, {invalid} baris tidak valid, {over} melebihi batas {max}."

msgid "Aucune entrée ne correspond : rien n'a été retiré."
msgstr "Tidak ada entri yang cocok: tidak ada yang dicabut."

#, python-brace-format
msgid ""
"Purge : {count} entrée(s) retirée(s) de la liste noire ; il en reste {left}."
msgstr "Pembersihan: {count} entri dicabut dari daftar hitam; tersisa {left}."

#, python-brace-format
msgid "Adresse invalide : {text}"
msgstr "Alamat tidak valid: {text}"

#, python-brace-format
msgid ""
"{address} → liste noire (refusée jusqu'au retrait), retirée de la confiance."
msgstr ""
"{address} → daftar hitam (ditolak sampai dicabut), dicabut dari daftar "
"tepercaya."

#, python-brace-format
msgid ""
"{address} est en confiance (jamais limitée) : la confiance passe avant le "
"blocage. Retirez-la de la confiance d'abord."
msgstr ""
"{address} tepercaya (tidak pernah dibatasi): kepercayaan didahulukan "
"daripada pemblokiran. Cabut dulu dari daftar tepercaya."

#, python-brace-format
msgid ""
"Porte injoignable ({error}) : blocage temporaire impossible porte arrêtée."
msgstr ""
"Gerbang tidak terjangkau ({error}): pemblokiran sementara tidak mungkin saat"
" gerbang berhenti."

#, python-brace-format
msgid "{address} → bloquée {minutes} min (blocage temporaire)."
msgstr "{address} → diblokir {minutes} menit (pemblokiran sementara)."

#, python-brace-format
msgid ""
"{address} → toujours refusée : elle fait partie d'un réseau en liste noire."
msgstr ""
"{address} → tetap ditolak: alamat ini termasuk jaringan di daftar hitam."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), retirée de la liste noire."
msgstr ""
"{address} → diizinkan (tunduk pada aturan), dicabut dari daftar hitam."

#, python-brace-format
msgid "{address} → admise (soumise aux règles), blocage temporaire levé."
msgstr ""
"{address} → diizinkan (tunduk pada aturan), pemblokiran sementara dicabut."

#, python-brace-format
msgid "{address} → confiance (jamais limitée), retirée de la liste noire."
msgstr ""
"{address} → tepercaya (tidak pernah dibatasi), dicabut dari daftar hitam."

#, python-brace-format
msgid "{address} → confiance (jamais limitée)."
msgstr "{address} → tepercaya (tidak pernah dibatasi)."

#, python-brace-format
msgid "{address} → toujours admise : elle fait partie du tailnet."
msgstr "{address} → selalu diizinkan: alamat ini termasuk tailnet."

#, python-brace-format
msgid "{address} → admise (soumise aux règles)."
msgstr "{address} → diizinkan (tunduk pada aturan)."

#, python-brace-format
msgid "Apprentissage recommencé : {days} jours avant que la référence compte."
msgstr "Pembelajaran dimulai ulang: {days} hari sebelum acuan diperhitungkan."

#, python-brace-format
msgid "Base AS / pays non mise à jour ({error}) : l'ancienne reste en place."
msgstr ""
"Basis data AS / negara tidak diperbarui ({error}): yang lama tetap dipakai."

#, python-brace-format
msgid "Base AS / pays à jour ({countries} plages pays, {asns} plages AS)."
msgstr ""
"Basis data AS / negara mutakhir ({countries} rentang negara, {asns} rentang "
"AS)."

msgid "habituelle"
msgstr "biasa"

msgid "limité en attaque"
msgstr "dibatasi saat serangan"

msgid "Funnel est coupé par le disjoncteur : rétablissez-le d'abord (Survie)."
msgstr ""
"Funnel diputus oleh pemutus sirkuit: pulihkan terlebih dahulu (Ketahanan)."

#, python-brace-format
msgid "Refusé par Tailscale ({error}) : rien n'a changé."
msgstr "Ditolak oleh Tailscale ({error}): tidak ada yang berubah."

#, python-brace-format
msgid "Changement impossible ({error}) : publication d'avant remise."
msgstr ""
"Perubahan tidak dapat dilakukan ({error}): publikasi sebelumnya dipulihkan."

#, python-brace-format
msgid "Publication incomplète ({error}) : restaurez la sauvegarde {path}."
msgstr "Publikasi tidak lengkap ({error}): pulihkan cadangan {path}."

#, python-brace-format
msgid "Ajout refusé : {reason}."
msgstr "Penambahan ditolak: {reason}."

#, python-brace-format
msgid "Publié : {kind} {port}{path} → {target} ({who})."
msgstr "Dipublikasikan: {kind} {port}{path} → {target} ({who})."

msgid ""
"Ce port passe par la porte : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord."
msgstr ""
"Port ini melewati gerbang: « Nonaktifkan perlindungan » (Firewall Funnel) "
"terlebih dahulu."

msgid "Ce point n'est plus publié."
msgstr "Titik ini tidak lagi dipublikasikan."

#, python-brace-format
msgid "Retiré : {kind} {port}{path}."
msgstr "Dicabut: {kind} {port}{path}."

#, python-brace-format
msgid "Sauvegarde illisible ({error})."
msgstr "Cadangan tidak terbaca ({error})."

msgid ""
"La protection est active : « Désactiver la protection » (Pare-feu Funnel) "
"d'abord, puis restaurez."
msgstr ""
"Perlindungan aktif: « Nonaktifkan perlindungan » (Firewall Funnel) terlebih "
"dahulu, lalu pulihkan."

msgid ""
"Cette sauvegarde passe par la porte, arrêtée : « Activer la protection » "
"(Pare-feu Funnel) la recrée proprement."
msgstr ""
"Cadangan ini melewati gerbang, yang sedang berhenti: « Aktifkan perlindungan"
" » (Firewall Funnel) akan membuatnya ulang dengan rapi."

#, python-brace-format
msgid "Sauvegarde du {when} restaurée."
msgstr "Cadangan tanggal {when} dipulihkan."

msgid "essai public indisponible"
msgstr "uji publik tidak tersedia"

msgid "adresse du tailnet inconnue"
msgstr "alamat tailnet tidak diketahui"

msgid "Funnel encore autorisé sur les ports"
msgstr "Funnel masih diizinkan pada port"

msgid "Funnel est déjà coupé par omega-tail."
msgstr "Funnel sudah diputus oleh omega-tail."

msgid "Rien à couper : aucun port n'est ouvert à Internet."
msgstr ""
"Tidak ada yang perlu diputus: tidak ada port yang terbuka ke Internet."

msgid "Remise en route programmée impossible ici."
msgstr "Penghidupan kembali terjadwal tidak dapat dilakukan di sini."

#, python-brace-format
msgid ""
"Minuterie de remise en route refusée (code {code}) : rien n'a été coupé."
msgstr ""
"Pewaktu penghidupan kembali ditolak (kode {code}): tidak ada yang diputus."

#, python-brace-format
msgid "Coupure impossible ({error}) : la publication a été remise."
msgstr ""
"Pemutusan tidak dapat dilakukan ({error}): publikasi telah dipulihkan."

#, python-brace-format
msgid ""
"Funnel coupé ({ports}) pour {minutes} min, puis remis en route "
"automatiquement."
msgstr ""
"Funnel diputus ({ports}) selama {minutes} menit, lalu dihidupkan kembali "
"secara otomatis."

#, python-brace-format
msgid "Funnel coupé ({ports}) jusqu'à votre remise en route."
msgstr "Funnel diputus ({ports}) sampai Anda menghidupkannya kembali."

msgid "Rien à rétablir : Funnel n'est pas coupé par omega-tail."
msgstr ""
"Tidak ada yang perlu dipulihkan: Funnel tidak diputus oleh omega-tail."

msgid "Minuterie d'une ancienne coupure : rien à faire."
msgstr "Pewaktu dari pemutusan lama: tidak ada yang perlu dilakukan."

#, python-brace-format
msgid "Remise en route incomplète ({errors}) : sauvegarde gardée dans {path}."
msgstr ""
"Penghidupan kembali tidak lengkap ({errors}): cadangan disimpan di {path}."

msgid "Funnel remis en route, à l'identique."
msgstr "Funnel dihidupkan kembali, persis seperti semula."

msgid "Tailscale n'est pas installé sur cette machine."
msgstr "Tailscale belum terpasang di mesin ini."

msgid "Le service tailscaled ne répond pas (arrêté ou en échec)."
msgstr "Layanan tailscaled tidak merespons (berhenti atau gagal)."

#, python-brace-format
msgid ""
"tailscaled n'a pas été redémarré après la mise à jour : {daemon} en marche, "
"{client} installé."
msgstr ""
"tailscaled belum dimulai ulang setelah pembaruan: {daemon} berjalan, "
"{client} terpasang."

msgid "Tailscale attend la connexion d'un compte."
msgstr "Tailscale menunggu koneksi sebuah akun."

msgid "Tailscale est déconnecté (« tailscale down »)."
msgstr "Tailscale terputus (« tailscale down »)."

#, python-brace-format
msgid "La clé de cette machine expire dans {days} jour(s)."
msgstr "Kunci mesin ini kedaluwarsa dalam {days} hari."

msgid ""
"Site en panne : Funnel passe par la porte (pare-feu), mais la porte est "
"arrêtée."
msgstr ""
"Situs mati: Funnel melewati gerbang (firewall), tetapi gerbang berhenti."

msgid ""
"La porte est en MODE ATTAQUE : trop de connexions entrantes ; les "
"regroupements (empreintes, AS, pays) s'appliquent jusqu'au retour au calme."
msgstr ""
"Gerbang dalam MODE SERANGAN: terlalu banyak koneksi masuk; pengelompokan "
"(sidik jari, AS, negara) berlaku sampai keadaan kembali tenang."

#, python-brace-format
msgid ""
"Funnel publié sans protection sur le port {port} : tailscaled fait le TLS de"
" chaque connexion (une rafale peut saturer la machine)."
msgstr ""
"Funnel dipublikasikan tanpa perlindungan di port {port}: tailscaled "
"melakukan TLS untuk setiap koneksi (satu lonjakan dapat membuat mesin "
"jenuh)."

#, python-brace-format
msgid "Température élevée : {temperature:.0f} °C."
msgstr "Suhu tinggi: {temperature:.0f} °C."

#, python-brace-format
msgid "tailscaled consomme {cpu:.0f} % d'un cœur."
msgstr "tailscaled memakai {cpu:.0f} % dari satu inti."

msgid ""
"La veille automatique est activée mais ne tourne plus : Funnel ne sera pas "
"coupé seul sous attaque."
msgstr ""
"Pengawasan otomatis aktif tetapi tidak lagi berjalan: Funnel tidak akan "
"diputus sendiri saat diserang."

#, python-brace-format
msgid ""
"Liste noire de la porte : {count} entrées (plafond {max}). Exportez-la puis "
"purgez les plus anciennes : « Attaques et décisions » → « Gestion de la "
"liste noire »."
msgstr ""
"Daftar hitam gerbang: {count} entri (batas {max}). Ekspor lalu bersihkan "
"yang paling lama: « Serangan dan keputusan » → « Pengelolaan daftar hitam »."

msgid ""
"Bouclier du port WireGuard ABSENT : un autre outil a effacé sa table (nft "
"flush ruleset, pare-feu relancé…). Il n'est pas reposé seul : « Survie » → «"
" Bouclier du port WireGuard » → « Reposer »."
msgstr ""
"Perisai port WireGuard TIDAK ADA: alat lain menghapus tabelnya (nft flush "
"ruleset, firewall dimulai ulang…). Perisai tidak dipasang ulang sendiri: « "
"Ketahanan » → « Perisai port WireGuard » → « Pasang ulang »."

msgid ""
"Bouclier du port WireGuard : état non mis à jour depuis plus de 3 minutes "
"(service omega-bouclier-wg arrêté ?)."
msgstr ""
"Perisai port WireGuard: status tidak diperbarui selama lebih dari 3 menit "
"(layanan omega-bouclier-wg berhenti?)."

msgid ""
"Le démarrage de tailscaled lance « tailscale up » : si un réglage change "
"(opérateur, nom, routes…), Tailscale le refusera et tailscaled ne "
"redémarrera plus. « Service » → « Corriger le démarrage »."
msgstr ""
"Saat tailscaled dimulai, ia menjalankan « tailscale up »: jika sebuah "
"pengaturan berubah (operator, nama, rute…), Tailscale akan menolaknya dan "
"tailscaled tidak akan mau mulai lagi. « Layanan » → « Perbaiki proses mulai "
"»."

msgid ""
"Confinement de tailscaled perdu (le service a redémarré) : « Survie » → « "
"Appliquer le confinement »."
msgstr ""
"Pembatasan tailscaled hilang (layanan dimulai ulang): « Ketahanan » → « "
"Terapkan pembatasan »."

msgid ""
"tailscaled n'est pas confiné : sous attaque, il peut prendre tous les cœurs."
msgstr ""
"tailscaled tidak dibatasi: saat diserang, ia dapat memakai semua inti."

msgid ""
"Vous n'êtes pas opérateur de Tailscale : chaque réglage demandera sudo."
msgstr "Anda bukan operator Tailscale: setiap pengaturan akan meminta sudo."

msgid ""
"Funnel coupé par omega-tail (coupure totale) : remise en route manuelle, "
"dans « Survie »."
msgstr ""
"Funnel diputus oleh omega-tail (pemutusan total): hidupkan kembali secara "
"manual di « Ketahanan »."

#, python-brace-format
msgid ""
"Funnel devait être remis en route à {time} et ne l'est pas : « Rétablir » "
"dans « Survie »."
msgstr ""
"Funnel seharusnya dihidupkan kembali pada {time} tetapi belum: « Pulihkan » "
"di « Ketahanan »."

#, python-brace-format
msgid ""
"Funnel coupé par omega-tail jusqu'à {time}, puis remis en route "
"automatiquement."
msgstr ""
"Funnel diputus oleh omega-tail sampai {time}, lalu dihidupkan kembali secara"
" otomatis."

